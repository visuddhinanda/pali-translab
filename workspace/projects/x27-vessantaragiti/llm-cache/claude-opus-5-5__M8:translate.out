{"id": "38-558-2-4", "zh": "109.", "confidence": 95}
{"id": "38-559-2-4", "zh": "他举行盛大的布施，", "confidence": 90}
{"id": "38-560-2-4", "zh": "一天又一天地施舍；", "confidence": 90}
{"id": "38-561-2-3", "zh": "他满心欢喜地施出六十万", "confidence": 75}
{"id": "38-562-2-4", "zh": "的财物。", "confidence": 75}
{"id": "38-563-2-4", "zh": "110.", "confidence": 95}
{"id": "38-564-2-5", "zh": "当他这样乐于布施的时候，", "confidence": 88}
{"id": "38-565-2-3", "zh": "这位国王的王后；", "confidence": 85}
{"id": "38-566-2-2", "zh": "玛迪在后来", "confidence": 75}
{"id": "38-567-2-4", "zh": "生下了一个相貌端好的儿子。", "confidence": 78}
{"id": "38-568-2-4", "zh": "111.", "confidence": 95}
{"id": "38-569-2-3", "zh": "在他出生", "confidence": 75}
{"id": "38-570-2-4", "zh": "的时候，人们用金网把他接住；", "confidence": 65}
{"id": "38-571-2-4", "zh": "因为那张金网，", "confidence": 82}
{"id": "38-572-2-4", "zh": "人们给他取名叫阇利。", "confidence": 82}
{"id": "38-573-2-4", "zh": "112.", "confidence": 95}
{"id": "38-574-2-6", "zh": "到了能用双脚走路的时候，", "confidence": 78}
{"id": "38-575-2-4", "zh": "也就是儿子阇利会走路时；", "confidence": 72}
{"id": "38-576-2-4", "zh": "她又生下了一个女儿，", "confidence": 88}
{"id": "38-577-2-4", "zh": "被公认为女子中最出众的。", "confidence": 85}
{"id": "38-578-2-4", "zh": "113.", "confidence": 95}
{"id": "38-579-2-4", "zh": "人们用黑羚羊皮把这个女儿", "confidence": 80}
{"id": "38-580-2-4", "zh": "恭敬地接住；", "confidence": 82}
{"id": "38-581-2-4", "zh": "因此，这个女儿的名字", "confidence": 85}
{"id": "38-582-2-4", "zh": "被称为甘哈吉娜。", "confidence": 80}
{"id": "38-583-2-4", "zh": "114.", "confidence": 95}
{"id": "38-584-2-4", "zh": "在众多侍从的簇拥下，", "confidence": 88}
{"id": "38-585-2-4", "zh": "他们两个渐渐长大；", "confidence": 85}
{"id": "38-586-2-4", "zh": "伴着歌舞入睡，", "confidence": 85}
{"id": "38-587-2-4", "zh": "又在歌舞声中醒来。", "confidence": 85}
{"id": "38-588-2-4", "zh": "115.", "confidence": 95}
{"id": "38-589-2-5", "zh": "大士每个月", "confidence": 85}
{"id": "38-590-2-4", "zh": "六次到布施堂；", "confidence": 82}
{"id": "38-591-2-3", "zh": "站在装饰华丽的", "confidence": 80}
{"id": "38-592-2-4", "zh": "上等大象背上巡视。", "confidence": 80}
{"id": "38-593-2-4", "zh": "116.", "confidence": 95}
{"id": "38-594-2-4", "zh": "那时在羯陵伽国，", "confidence": 85}
{"id": "38-595-2-4", "zh": "发生了可怕的旱灾；", "confidence": 85}
{"id": "38-596-2-4", "zh": "庄稼没有收成，", "confidence": 88}
{"id": "38-597-2-4", "zh": "正赶上饥荒的年头。", "confidence": 85}
{"id": "38-598-2-4", "zh": "117.", "confidence": 95}
{"id": "38-599-2-5", "zh": "人们做起了盗贼的勾当，", "confidence": 85}
{"id": "38-600-2-4", "zh": "只因实在活不下去；", "confidence": 85}
{"id": "38-601-2-4", "zh": "在城镇和村庄里，", "confidence": 85}
{"id": "38-602-2-4", "zh": "暴徒四处抢掠。", "confidence": 78}
{"id": "38-603-2-4", "zh": "118.", "confidence": 95}
{"id": "38-604-2-4", "zh": "整个羯陵伽国", "confidence": 88}
{"id": "38-605-2-3", "zh": "受着饥荒恐慌的煎熬；", "confidence": 82}
{"id": "38-606-2-4", "zh": "就像罐子里晃荡的水一样，", "confidence": 55}
{"id": "38-607-2-4", "zh": "无依无靠，动荡不安。", "confidence": 65}
{"id": "38-608-2-4", "zh": "119.", "confidence": 95}
{"id": "38-609-2-4", "zh": "所有城镇居民和乡村百姓，", "confidence": 85}
{"id": "38-610-2-4", "zh": "还有都城的居民，都聚集起来；", "confidence": 82}
{"id": "38-611-2-4", "zh": "在王宫庭院里大声呼喊，", "confidence": 85}
{"id": "38-612-2-4", "zh": "是饥荒的恐慌逼得他们这样做。", "confidence": 80}
{"id": "38-613-2-4", "zh": "120.", "confidence": 95}
{"id": "38-614-2-5", "zh": "国王这时听到了呼喊声，", "confidence": 85}
{"id": "38-615-2-4", "zh": "心里顿时惊慌起来；", "confidence": 85}
{"id": "38-616-2-4", "zh": "他问道：“这是什么声音？”", "confidence": 88}
{"id": "38-617-2-4", "zh": "问的是身边的大臣们。", "confidence": 82}
{"id": "38-618-2-4", "zh": "121.", "confidence": 95}
{"id": "38-619-2-4", "zh": "大臣们向国王禀报，", "confidence": 88}
{"id": "38-620-2-4", "zh": "把事情原原本本地说了出来；", "confidence": 85}
{"id": "38-621-2-4", "zh": "国王也许诺说：", "confidence": 80}
{"id": "38-622-2-4", "zh": "“我会让天降雨。”", "confidence": 78}
{"id": "38-623-2-4", "zh": "122.", "confidence": 95}
{"id": "38-624-2-4", "zh": "于是他发愿祈求，", "confidence": 82}
{"id": "38-625-2-4", "zh": "受持布萨戒；", "confidence": 85}
{"id": "38-626-2-4", "zh": "为了让天降下雨来，", "confidence": 85}
{"id": "38-627-2-3", "zh": "这位怜悯众生的国王坚持了七天。", "confidence": 72}
{"id": "38-628-2-4", "zh": "123.", "confidence": 95}
{"id": "38-629-2-4", "zh": "可是即使这样，", "confidence": 82}
{"id": "38-630-2-4", "zh": "这位人间之主还是没能降下雨；", "confidence": 80}
{"id": "38-631-2-4", "zh": "羯陵伽国依然没有雨云，", "confidence": 72}
{"id": "38-632-2-4", "zh": "旱灾照旧持续。", "confidence": 75}
{"id": "38-633-2-4", "zh": "124.", "confidence": 95}
{"id": "38-634-2-4", "zh": "于是他把都城的居民", "confidence": 85}
{"id": "38-635-2-4", "zh": "召集起来，对他们这样说；", "confidence": 85}
{"id": "38-636-2-4", "zh": "“我没能让", "confidence": 82}
{"id": "38-637-2-5", "zh": "天降下雨来，我该怎么办呢？”", "confidence": 82}
