{"id": "38-158-2-4", "zh": "29.", "confidence": 95}
{"id": "38-159-2-3", "zh": "她从那天界死后，", "confidence": 85}
{"id": "38-160-2-5", "zh": "如自己所愿投生人间；", "confidence": 75}
{"id": "38-161-2-3", "zh": "在摩达国王王后的胎中", "confidence": 75}
{"id": "38-162-2-4", "zh": "受生入胎。", "confidence": 75}
{"id": "38-163-2-4", "zh": "30.", "confidence": 95}
{"id": "38-164-2-5", "zh": "满了十个月，", "confidence": 75}
{"id": "38-165-2-4", "zh": "这位摩达王后", "confidence": 75}
{"id": "38-166-2-3", "zh": "在洁白的华盖之下，", "confidence": 80}
{"id": "38-167-2-4", "zh": "生下了一个容貌绝美的女儿。", "confidence": 80}
{"id": "38-168-2-4", "zh": "31.", "confidence": 95}
{"id": "38-169-2-4", "zh": "她的身体就像用红檀香", "confidence": 70}
{"id": "38-170-2-4", "zh": "涂抹过一样；", "confidence": 65}
{"id": "38-171-2-4", "zh": "因此婆罗门们给她", "confidence": 80}
{"id": "38-172-2-4", "zh": "取名为“普沙蒂（Phusatī）”。", "confidence": 75}
{"id": "38-173-2-4", "zh": "32.", "confidence": 95}
{"id": "38-174-2-3", "zh": "命名、上摇篮", "confidence": 70}
{"id": "38-175-2-4", "zh": "等吉祥仪式办完以后；", "confidence": 75}
{"id": "38-176-2-4", "zh": "王族妇女们以盛大的排场", "confidence": 75}
{"id": "38-177-2-4", "zh": "养育她。", "confidence": 80}
{"id": "38-178-2-4", "zh": "33.", "confidence": 95}
{"id": "38-179-2-5", "zh": "乳汁甘甜充足、", "confidence": 75}
{"id": "38-180-2-4", "zh": "身体丰润、正值青春的", "confidence": 70}
{"id": "38-181-2-4", "zh": "乳母们给这位王女", "confidence": 75}
{"id": "38-182-2-4", "zh": "喂奶，把她养大。", "confidence": 75}
{"id": "38-183-2-4", "zh": "34.", "confidence": 95}
{"id": "38-184-2-4", "zh": "她就这样被人传来传去，渐渐长大，", "confidence": 60}
{"id": "38-185-2-4", "zh": "从这个怀抱到那个怀抱，从这双手到那双手；", "confidence": 70}
{"id": "38-186-2-4", "zh": "王族少女们", "confidence": 65}
{"id": "38-187-2-4", "zh": "和舞女们用歌舞让她欢喜。", "confidence": 65}
{"id": "38-188-2-4", "zh": "35.", "confidence": 95}
{"id": "38-189-2-3", "zh": "她容貌就像殊胜的天女，", "confidence": 75}
{"id": "38-190-2-4", "zh": "十六岁时美丽动人；", "confidence": 75}
{"id": "38-191-2-5", "zh": "她吸引着人们的目光，", "confidence": 65}
{"id": "38-192-2-3", "zh": "看见她的人都满心欢喜。", "confidence": 70}
{"id": "38-193-2-4", "zh": "36.", "confidence": 95}
{"id": "38-194-2-4", "zh": "那时，在尸毗国，", "confidence": 80}
{"id": "38-195-2-4", "zh": "尸毗王在胜城（Jetuttara）", "confidence": 75}
{"id": "38-196-2-3", "zh": "治理王国；他有一个名叫珊阇耶（Sañjaya）的", "confidence": 70}
{"id": "38-197-2-4", "zh": "儿子，声名远扬。", "confidence": 75}
{"id": "38-198-2-4", "zh": "37.", "confidence": 95}
{"id": "38-199-2-4", "zh": "成年以后，珊阇耶容貌俊美，", "confidence": 75}
{"id": "38-200-2-4", "zh": "就像天子一样；", "confidence": 80}
{"id": "38-201-2-4", "zh": "身材高大匀称，", "confidence": 70}
{"id": "38-202-2-4", "zh": "精通各种技艺。", "confidence": 80}
{"id": "38-203-2-4", "zh": "38.", "confidence": 95}
{"id": "38-204-2-5", "zh": "尸毗王把王国交给珊阇耶，", "confidence": 75}
{"id": "38-205-2-4", "zh": "交给了自己的儿子；", "confidence": 75}
{"id": "38-206-2-3", "zh": "他想趁自己还活着，亲眼看到儿子享有", "confidence": 70}
{"id": "38-207-2-4", "zh": "尊贵无比的王者荣光。", "confidence": 70}
{"id": "38-208-2-4", "zh": "39.", "confidence": 95}
{"id": "38-209-2-4", "zh": "他从摩达王那里", "confidence": 75}
{"id": "38-210-2-4", "zh": "把公主普沙蒂迎娶过来；", "confidence": 75}
{"id": "38-211-2-4", "zh": "在一万六千名妃嫔之中，", "confidence": 75}
{"id": "38-212-2-4", "zh": "立她为首席王后。", "confidence": 80}
{"id": "38-213-2-4", "zh": "40.", "confidence": 95}
{"id": "38-214-2-3", "zh": "普沙蒂和珊阇耶两人", "confidence": 75}
{"id": "38-215-2-3", "zh": "用充满爱意的目光看着对方的脸；", "confidence": 70}
{"id": "38-216-2-3", "zh": "就这样相看相守地生活，", "confidence": 70}
{"id": "38-217-2-3", "zh": "彼此说着亲爱的话。", "confidence": 75}
{"id": "38-218-2-4", "zh": "41.", "confidence": 95}
{"id": "38-219-2-4", "zh": "这时，天帝心想：", "confidence": 80}
{"id": "38-220-2-3", "zh": "“我曾赐给普沙蒂", "confidence": 75}
{"id": "38-221-2-3", "zh": "十个愿望，其中求子", "confidence": 75}
{"id": "38-222-2-3", "zh": "这个愿望还没有实现。", "confidence": 75}
{"id": "38-223-2-4", "zh": "42.", "confidence": 95}
{"id": "38-224-2-4", "zh": "我要让它实现。”", "confidence": 70}
{"id": "38-225-2-3", "zh": "他在不可战胜的三十三天宫中", "confidence": 60}
{"id": "38-226-2-3", "zh": "仔细察看，寻找配得上", "confidence": 65}
{"id": "38-227-2-3", "zh": "做她儿子的天神。", "confidence": 70}
{"id": "38-228-2-4", "zh": "43.", "confidence": 95}
{"id": "38-229-2-4", "zh": "原来那位死后将往更高处去的", "confidence": 55}
{"id": "38-230-2-3", "zh": "菩萨天神就在那里；", "confidence": 55}
{"id": "38-231-2-3", "zh": "千眼天帝去到他面前，", "confidence": 55}
{"id": "38-232-2-3", "zh": "对他说了这番话。", "confidence": 80}
{"id": "38-233-2-4", "zh": "44.", "confidence": 95}
{"id": "38-234-2-5", "zh": "“尊者，请从这里往生善趣，", "confidence": 70}
{"id": "38-235-2-3", "zh": "贤友，请怜悯我吧；", "confidence": 70}
{"id": "38-236-2-3", "zh": "到珊阇耶的王后那里，", "confidence": 65}
{"id": "38-237-2-4", "zh": "去受生入胎吧，光辉的天神。”", "confidence": 65}
