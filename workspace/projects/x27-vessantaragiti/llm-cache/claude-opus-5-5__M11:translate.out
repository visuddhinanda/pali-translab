{"id": "38-798-2-4", "zh": "156.", "confidence": 95}
{"id": "38-799-2-5", "zh": "此外还有五百", "confidence": 80}
{"id": "38-800-2-4", "zh": "侍奉大象的随从；", "confidence": 75}
{"id": "38-801-2-4", "zh": "连同象夫的家族，", "confidence": 75}
{"id": "38-802-2-5", "zh": "他都恭恭敬敬地一并施舍了。", "confidence": 80}
{"id": "38-803-2-4", "zh": "158.", "confidence": 95}
{"id": "38-804-2-4", "zh": "当维山达拉施舍了", "confidence": 85}
{"id": "38-805-2-5", "zh": "那头吉祥的白象时；", "confidence": 85}
{"id": "38-806-2-3", "zh": "连无情之物也发出轰鸣，", "confidence": 70}
{"id": "38-807-2-5", "zh": "大地剧烈地震动摇晃。", "confidence": 80}
{"id": "38-808-2-4", "zh": "159.", "confidence": 95}
{"id": "38-809-2-6", "zh": "那时出现了可怕的景象，", "confidence": 85}
{"id": "38-810-2-4", "zh": "种种令人毛骨悚然的事；", "confidence": 80}
{"id": "38-811-2-5", "zh": "巨大而广远的声响，", "confidence": 85}
{"id": "38-812-2-5", "zh": "震动了整座城市。", "confidence": 85}
{"id": "38-813-2-4", "zh": "160.", "confidence": 95}
{"id": "38-814-2-3", "zh": "因大地轰鸣而引起的惊骇，", "confidence": 70}
{"id": "38-815-2-5", "zh": "云立刻降下雨来；", "confidence": 85}
{"id": "38-816-2-4", "zh": "浓密的大雨倾盆而下，", "confidence": 85}
{"id": "38-817-2-5", "zh": "雷声在四方轰鸣。", "confidence": 80}
{"id": "38-818-2-4", "zh": "161.", "confidence": 95}
{"id": "38-819-2-3", "zh": "许多道闪电迸射而出，", "confidence": 80}
{"id": "38-820-2-5", "zh": "在四面八方闪现；", "confidence": 75}
{"id": "38-821-2-4", "zh": "彩虹升起，", "confidence": 85}
{"id": "38-822-2-5", "zh": "那时还有流星坠落。", "confidence": 85}
{"id": "38-823-2-4", "zh": "162.", "confidence": 95}
{"id": "38-824-2-6", "zh": "得到大象以后，他们满心欢喜，", "confidence": 85}
{"id": "38-825-2-3", "zh": "据说婆罗门们从南", "confidence": 65}
{"id": "38-826-2-5", "zh": "门出发，穿过城中央，", "confidence": 70}
{"id": "38-827-2-4", "zh": "骑在象背上前行。", "confidence": 80}
{"id": "38-828-2-4", "zh": "163.", "confidence": 95}
{"id": "38-829-2-3", "zh": "在大众的簇拥下，", "confidence": 75}
{"id": "38-830-2-4", "zh": "婆罗门们骑在象上；", "confidence": 75}
{"id": "38-831-2-5", "zh": "全体市民看见了，", "confidence": 80}
{"id": "38-832-2-4", "zh": "那时他们这样说道：", "confidence": 85}
{"id": "38-833-2-4", "zh": "164.", "confidence": 95}
{"id": "38-834-2-6", "zh": "“喂，你们骑着我们的象，", "confidence": 85}
{"id": "38-835-2-5", "zh": "来到这里；", "confidence": 85}
{"id": "38-836-2-5", "zh": "是谁把它给了你们？", "confidence": 90}
{"id": "38-837-2-5", "zh": "什么时候、从哪里得到的？”", "confidence": 85}
{"id": "38-838-2-4", "zh": "165.", "confidence": 95}
{"id": "38-839-2-5", "zh": "“是维山达拉施舍给我们的，", "confidence": 85}
{"id": "38-840-2-4", "zh": "你们能说什么呢？", "confidence": 75}
{"id": "38-841-2-4", "zh": "我们不多讲了，", "confidence": 80}
{"id": "38-842-2-5", "zh": "我们要离开这座城了。”", "confidence": 70}
{"id": "38-843-2-4", "zh": "166.", "confidence": 95}
{"id": "38-844-2-4", "zh": "说完这话，他们就出发了，", "confidence": 85}
{"id": "38-845-2-4", "zh": "从北门出了城；", "confidence": 85}
{"id": "38-846-2-5", "zh": "就在市民们心慌意乱的时候，", "confidence": 65}
{"id": "38-847-2-4", "zh": "这些迦陵伽人离去了。", "confidence": 65}
{"id": "38-848-2-4", "zh": "167.", "confidence": 95}
{"id": "38-849-2-5", "zh": "那时全体市民", "confidence": 85}
{"id": "38-850-2-4", "zh": "都对菩萨十分恼怒；", "confidence": 85}
{"id": "38-851-2-4", "zh": "他们聚集在王宫门前，", "confidence": 85}
{"id": "38-852-2-4", "zh": "大声喧嚷抗议。", "confidence": 80}
{"id": "38-853-2-4", "zh": "168.", "confidence": 95}
{"id": "38-854-2-3", "zh": "“诸位，他完全不合正法，", "confidence": 60}
{"id": "38-855-2-5", "zh": "把受全国尊崇的我们的象；", "confidence": 70}
{"id": "38-856-2-2", "zh": "维山达拉竟施舍给了邪恶的", "confidence": 70}
{"id": "38-857-2-3", "zh": "婆罗门，连同全身的装饰。”", "confidence": 65}
{"id": "38-858-2-4", "zh": "169.", "confidence": 95}
{"id": "38-859-2-5", "zh": "所有人都心中惊乱不安，", "confidence": 80}
{"id": "38-860-2-3", "zh": "于是城中居民", "confidence": 85}
{"id": "38-861-2-4", "zh": "来到珊阇耶王", "confidence": 80}
{"id": "38-862-2-4", "zh": "面前，这样说道：", "confidence": 85}
{"id": "38-863-2-4", "zh": "170.", "confidence": 95}
{"id": "38-864-2-3", "zh": "“陛下，毁坏您国家的，", "confidence": 70}
{"id": "38-865-2-3", "zh": "正是您的儿子维山达拉；", "confidence": 75}
{"id": "38-866-2-3", "zh": "他怎么能施舍那头大象，", "confidence": 80}
{"id": "38-867-2-3", "zh": "那头受全西维国尊崇的大象？", "confidence": 80}
{"id": "38-868-2-4", "zh": "171.", "confidence": 95}
{"id": "38-869-2-5", "zh": "他怎么能施舍这头大象，", "confidence": 85}
{"id": "38-870-2-4", "zh": "它洁白如吉罗娑山；", "confidence": 80}
{"id": "38-871-2-3", "zh": "身披淡黄色的毛毯，", "confidence": 75}
{"id": "38-872-2-5", "zh": "是人们克敌制胜的依靠。", "confidence": 50}
{"id": "38-873-2-4", "zh": "172.", "confidence": 95}
{"id": "38-874-2-5", "zh": "如果他想要施舍，", "confidence": 85}
{"id": "38-875-2-3", "zh": "饭食、饮料和食物；", "confidence": 85}
{"id": "38-876-2-5", "zh": "衣服、住处、黄金，", "confidence": 85}
{"id": "38-877-2-4", "zh": "随心意施舍这些才合适。”", "confidence": 80}
