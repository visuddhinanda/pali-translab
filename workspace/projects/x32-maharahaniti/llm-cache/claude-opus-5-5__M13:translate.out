{"id": "30-941-2-4", "zh": "187.", "confidence": 95}
{"id": "30-942-2-4", "zh": "布施是赢得情谊的良药，", "confidence": 80}
{"id": "30-943-2-4", "zh": "悭吝是招来怨恨的药；", "confidence": 65}
{"id": "30-944-2-4", "zh": "布施是带来名声的良药，", "confidence": 80}
{"id": "30-945-2-4", "zh": "悭吝是招致贫贱的药。", "confidence": 45}
{"id": "30-946-2-4", "zh": "188.", "confidence": 95}
{"id": "30-947-2-5", "zh": "在饥荒时施与食物，", "confidence": 85}
{"id": "30-948-2-4", "zh": "在丰年时施与钱财；", "confidence": 80}
{"id": "30-949-2-3", "zh": "在危难时施与无畏，", "confidence": 80}
{"id": "30-950-2-5", "zh": "这样的人即使在天界也受到推崇。", "confidence": 55}
{"id": "30-951-2-4", "zh": "189.", "confidence": 95}
{"id": "30-952-2-4", "zh": "百只眼睛，百只耳朵，", "confidence": 75}
{"id": "30-953-2-5", "zh": "领袖总是什么都听得到；", "confidence": 55}
{"id": "30-954-2-4", "zh": "可是他又要像盲人、像聋子一样；", "confidence": 60}
{"id": "30-955-2-4", "zh": "这就是领袖应有的本色。", "confidence": 75}
{"id": "30-956-2-4", "zh": "190.", "confidence": 95}
{"id": "30-957-2-5", "zh": "忍耐、警醒、勤奋，", "confidence": 80}
{"id": "30-958-2-4", "zh": "乐于分享、慈悲、有远见；", "confidence": 65}
{"id": "30-959-2-4", "zh": "这些是领袖的品德，", "confidence": 85}
{"id": "30-960-2-4", "zh": "追求利益的人应当具备。", "confidence": 75}
{"id": "30-961-2-4", "zh": "191.", "confidence": 95}
{"id": "30-962-2-6", "zh": "过于柔和就会受人轻视，", "confidence": 80}
{"id": "30-963-2-4", "zh": "过于严厉就会招人怨恨；", "confidence": 80}
{"id": "30-964-2-4", "zh": "明白了这两种情形，", "confidence": 80}
{"id": "30-965-2-4", "zh": "就应当采取适中的做法。", "confidence": 75}
{"id": "30-966-2-4", "zh": "192.", "confidence": 95}
{"id": "30-967-2-4", "zh": "一味柔和不能做到，", "confidence": 75}
{"id": "30-968-2-3", "zh": "一味严厉也不能做到——", "confidence": 75}
{"id": "30-969-2-5", "zh": "把自己安置在高位上，", "confidence": 70}
{"id": "30-970-2-5", "zh": "所以应当两者兼用。", "confidence": 80}
{"id": "30-971-2-4", "zh": "193.", "confidence": 95}
{"id": "30-972-2-6", "zh": "应当用背部去晒太阳，", "confidence": 65}
{"id": "30-973-2-4", "zh": "用腹部去烤火；", "confidence": 70}
{"id": "30-974-2-4", "zh": "应当全心全意地侍奉主人，", "confidence": 75}
{"id": "30-975-2-4", "zh": "应当不欺不诈地面对来世。", "confidence": 65}
{"id": "30-976-2-4", "zh": "194.", "confidence": 95}
{"id": "30-977-2-4", "zh": "不要侍奉粗暴的主人，", "confidence": 80}
{"id": "30-978-2-5", "zh": "也不要侍奉悭吝的主人；", "confidence": 80}
{"id": "30-979-2-4", "zh": "比起他们，应当侍奉肯提携下属的主人，", "confidence": 55}
{"id": "30-980-2-5", "zh": "其次，也可以侍奉会管教下属的主人。", "confidence": 45}
{"id": "30-981-2-4", "zh": "195.", "confidence": 95}
{"id": "30-982-2-8", "zh": "去征服不该征服的人，这不是好国王；", "confidence": 60}
{"id": "30-983-2-7", "zh": "去压倒朋友的人，这不是真朋友；", "confidence": 70}
{"id": "30-984-2-7", "zh": "违逆丈夫的女人，这不是好妻子；", "confidence": 70}
{"id": "30-985-2-8", "zh": "不赡养年老父母的人，这不是好儿子。", "confidence": 60}
{"id": "30-986-2-4", "zh": "196.", "confidence": 95}
{"id": "30-987-2-9", "zh": "没有善人在场的地方，不算是集会；", "confidence": 80}
{"id": "30-988-2-8", "zh": "不宣说正法的人，不算是善人；", "confidence": 80}
{"id": "30-989-2-6", "zh": "舍弃了贪、瞋和痴，", "confidence": 85}
{"id": "30-990-2-6", "zh": "宣说正法的人才是善人。", "confidence": 80}
{"id": "30-991-2-4", "zh": "197.", "confidence": 95}
{"id": "30-992-2-5", "zh": "学问要靠持续用功来守护；", "confidence": 70}
{"id": "30-993-2-6", "zh": "家族要靠品行来守护，人要靠学识来守护；", "confidence": 55}
{"id": "30-994-2-5", "zh": "国王要靠警惕放逸来守护，财富要靠安分来守护，", "confidence": 30}
{"id": "30-995-2-7", "zh": "至于女人，我知道她们是根本守护不住的。", "confidence": 65}
{"id": "30-996-2-2", "zh": "论女人", "confidence": 85}
{"id": "30-997-2-4", "zh": "198.", "confidence": 95}
