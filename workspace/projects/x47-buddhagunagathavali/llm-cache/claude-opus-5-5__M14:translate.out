{"id": "8-690-2-8", "zh": "心无愚痴、心具智慧，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-690-9-10", "zh": "343.", "confidence": 95}
{"id": "8-691-2-7", "zh": "心地善良、心地清净，心怀吉祥、具足正念；", "confidence": 85}
{"id": "8-692-2-8", "zh": "心地优美、心地安稳，我礼敬那位佛陀。", "confidence": 75}
{"id": "8-692-9-10", "zh": "344.", "confidence": 95}
{"id": "8-693-2-7", "zh": "心向于法、心向于义，心志坚毅、心最殊胜；", "confidence": 75}
{"id": "8-694-2-8", "zh": "心有惭耻、心有光辉，我礼敬那位佛陀。", "confidence": 75}
{"id": "8-694-9-10", "zh": "345.", "confidence": 95}
{"id": "8-695-2-7", "zh": "心怀利益、心怀安乐，心性善美、满怀悲悯；", "confidence": 80}
{"id": "8-696-2-8", "zh": "心怀喜悦、心地清凉，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-696-9-10", "zh": "346.", "confidence": 95}
{"id": "8-697-2-6", "zh": "心极其清净，心已解脱，是最上的修行者；", "confidence": 80}
{"id": "8-698-2-8", "zh": "心能自制、心持禁戒，我礼敬那位佛陀。", "confidence": 70}
{"id": "8-698-9-10", "zh": "347.", "confidence": 95}
{"id": "8-699-2-7", "zh": "心中欢喜、心中满足，心最殊胜、极为超绝；", "confidence": 80}
{"id": "8-700-2-8", "zh": "心常知足、满心欢喜，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-700-9-10", "zh": "348.", "confidence": 95}
{"id": "8-701-2-7", "zh": "心有正念、心能自制，具足正知、勤于精进；", "confidence": 80}
{"id": "8-702-2-8", "zh": "心有善慧、具足智慧，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-702-9-10", "zh": "349.", "confidence": 95}
{"id": "8-703-2-7", "zh": "心怀慈爱、心怀怜悯，心怀悲愍、圆满无缺；", "confidence": 75}
{"id": "8-704-2-8", "zh": "心中喜悦、心地柔和，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-704-9-10", "zh": "350.", "confidence": 95}
{"id": "8-705-2-7", "zh": "心存真实、心存如实，心具美德、持戒清净；", "confidence": 80}
{"id": "8-706-2-8", "zh": "心无贪婪、心地善好，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-706-9-10", "zh": "351.", "confidence": 95}
{"id": "8-707-2-7", "zh": "心无瞋恨、洁净无垢，心无愚痴、无所依附；", "confidence": 70}
{"id": "8-708-2-8", "zh": "心无污垢、无所染着，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-708-9-10", "zh": "352.", "confidence": 95}
{"id": "8-709-2-7", "zh": "心如天界般殊妙、心性贤良，心受调伏、具足十力；", "confidence": 65}
{"id": "8-710-2-8", "zh": "乐于贤善之性、自身贤善，我礼敬那位佛陀。", "confidence": 60}
{"id": "8-710-9-10", "zh": "353.", "confidence": 95}
{"id": "8-711-2-7", "zh": "心具智识、心具聪慧，心具明（vijjā）、以明为财富；", "confidence": 75}
{"id": "8-712-2-8", "zh": "心具慧、心具完全智，我礼敬那位佛陀。", "confidence": 70}
{"id": "8-712-9-10", "zh": "354.", "confidence": 95}
{"id": "8-713-2-7", "zh": "心有光辉、心有光明，心如月光皎洁、施予光明；", "confidence": 70}
{"id": "8-714-2-8", "zh": "心可爱悦、心能忍耐，我礼敬那位佛陀。", "confidence": 75}
{"id": "8-714-9-10", "zh": "355.", "confidence": 95}
{"id": "8-715-2-7", "zh": "没有污垢、心地洁白，心地明净、温和良善；", "confidence": 80}
{"id": "8-716-2-8", "zh": "能净化他人、心已净化，我礼敬那位佛陀。", "confidence": 70}
{"id": "8-716-9-10", "zh": "356.", "confidence": 95}
{"id": "8-717-2-7", "zh": "心思迅捷、心有力量，心志坚强、无所畏惧；", "confidence": 75}
{"id": "8-718-2-8", "zh": "心能安住、心地坚固，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-718-9-10", "zh": "357.", "confidence": 95}
{"id": "8-719-2-7", "zh": "心有活力、心有威光，心如战士、不可动摇；", "confidence": 70}
{"id": "8-720-2-8", "zh": "心无畏惧、毫不颤动，我礼敬那位佛陀。", "confidence": 80}
{"id": "8-720-9-10", "zh": "358.", "confidence": 95}
{"id": "8-721-2-7", "zh": "娴熟通达、心具妙慧，心能自制、善加守护；", "confidence": 70}
{"id": "8-722-2-8", "zh": "心地明净、身心轻安，我礼敬那位佛陀。", "confidence": 80}
{"id": "8-722-9-10", "zh": "359.", "confidence": 95}
{"id": "8-723-2-7", "zh": "心地贤善、心向解脱，在一切之中最殊胜、在众生之中最上；", "confidence": 80}
{"id": "8-724-2-8", "zh": "心中欣悦、安然寂静，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-724-9-10", "zh": "360.", "confidence": 95}
{"id": "8-725-2-7", "zh": "心已寂静、心已调伏，心得自在、梵行已经圆满；", "confidence": 75}
{"id": "8-726-2-8", "zh": "心地纯净、心有光彩，我礼敬那位佛陀。", "confidence": 80}
{"id": "8-726-9-10", "zh": "361.", "confidence": 95}
{"id": "8-727-2-7", "zh": "心受守护、心已解脱，心地明净、心地正直；", "confidence": 80}
{"id": "8-728-2-8", "zh": "心中愉悦、心地善好，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-728-9-10", "zh": "362.", "confidence": 95}
{"id": "8-729-2-8", "zh": "心已寂静、始终安详，是始终知足的仙人；", "confidence": 80}
{"id": "8-730-2-9", "zh": "在一切处都善加守护的主尊，我礼敬那位佛陀。", "confidence": 80}
{"id": "8-730-10-11", "zh": "363.", "confidence": 95}
{"id": "8-731-2-7", "zh": "离尽欲爱、离尽渴爱，离尽贪染、离尽尘垢；", "confidence": 80}
{"id": "8-732-2-8", "zh": "离尽欲求、离尽喜贪，我礼敬那位佛陀。", "confidence": 80}
{"id": "8-732-9-10", "zh": "364.", "confidence": 95}
{"id": "8-733-2-7", "zh": "离尽怨恨、离尽愤怒，离尽热恼、离尽浑浊；", "confidence": 80}
{"id": "8-734-2-8", "zh": "离尽忿怒、离尽恼怒，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-734-9-10", "zh": "365.", "confidence": 95}
{"id": "8-735-2-7", "zh": "远离执着、远离染色，远离贪欲、离尽贪乐；", "confidence": 70}
{"id": "8-736-2-8", "zh": "远离喜贪、远离渴爱，我礼敬那位佛陀。", "confidence": 85}
{"id": "8-736-9-10", "zh": "366.", "confidence": 95}
{"id": "8-737-2-5", "zh": "远离一切存在的病苦，离尽大愚痴的黑暗；", "confidence": 80}
{"id": "8-738-2-8", "zh": "完全远离无明，我礼敬那位佛陀。", "confidence": 90}
{"id": "8-738-9-10", "zh": "367.", "confidence": 95}
{"id": "8-739-2-5", "zh": "远离喜贪的结缚，舍弃一切执着；", "confidence": 85}
{"id": "8-740-2-8", "zh": "已把最上的义利握在手中，我礼敬那位佛陀。", "confidence": 80}
{"id": "8-740-9-10", "zh": "368.", "confidence": 95}
{"id": "8-741-2-7", "zh": "远离动摇、远离烦恼之火，远离欲求、离尽罪恶；", "confidence": 60}
{"id": "8-742-2-8", "zh": "远离烦恼的薪柴、远离贪求，我礼敬那位佛陀。", "confidence": 55}
{"id": "8-742-9-10", "zh": "369.", "confidence": 95}
