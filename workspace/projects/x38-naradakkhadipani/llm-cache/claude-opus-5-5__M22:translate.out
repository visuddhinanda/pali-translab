{"id": "35-1618-2-4", "zh": "294.", "confidence": 90}
{"id": "35-1619-2-6", "zh": "为求涅槃而受持的，", "confidence": 75}
{"id": "35-1620-2-4", "zh": "即使是五戒，也是增上戒；", "confidence": 80}
{"id": "35-1621-2-4", "zh": "十戒也同样是增上戒。", "confidence": 80}
{"id": "35-1622-2-3", "zh": "（一）", "confidence": 65}
{"id": "35-1623-2-5", "zh": "在旃陀婆提城，", "confidence": 75}
{"id": "35-1624-2-5", "zh": "那时我是一名雇工；", "confidence": 85}
{"id": "35-1625-2-4", "zh": "受雇于他人做工，", "confidence": 80}
{"id": "35-1626-2-5", "zh": "我没能得到出家的机会。", "confidence": 80}
{"id": "35-1627-2-3", "zh": "（二）", "confidence": 65}
{"id": "35-1628-2-4", "zh": "众生被大黑暗所覆盖，", "confidence": 70}
{"id": "35-1629-2-4", "zh": "被三种火焚烧；", "confidence": 80}
{"id": "35-1630-2-5", "zh": "究竟要用什么方法，", "confidence": 85}
{"id": "35-1631-2-5", "zh": "我才能从中解脱？", "confidence": 75}
{"id": "35-1632-2-3", "zh": "（三）", "confidence": 65}
{"id": "35-1633-2-7", "zh": "我没有可以布施的财物，", "confidence": 85}
{"id": "35-1634-2-5", "zh": "我是一个困苦的雇工；", "confidence": 85}
{"id": "35-1635-2-5", "zh": "不如我把五戒", "confidence": 80}
{"id": "35-1636-2-4", "zh": "圆满地守护起来。", "confidence": 80}
{"id": "35-1637-2-3", "zh": "（四）", "confidence": 65}
{"id": "35-1638-2-4", "zh": "阿诺玛达西牟尼有一位", "confidence": 75}
{"id": "35-1639-2-5", "zh": "名叫尼沙婆的弟子；", "confidence": 75}
{"id": "35-1640-2-4", "zh": "我去到他那里，", "confidence": 85}
{"id": "35-1641-2-3", "zh": "受持了五学处。", "confidence": 85}
{"id": "35-1642-2-3", "zh": "（五）", "confidence": 65}
{"id": "35-1643-2-4", "zh": "十万年，", "confidence": 80}
{"id": "35-1644-2-5", "zh": "那时人的寿命就有这么长；", "confidence": 75}
{"id": "35-1645-2-4", "zh": "在这么长的时间里，我把五戒", "confidence": 80}
{"id": "35-1646-2-4", "zh": "圆满地守护着。", "confidence": 80}
{"id": "35-1647-2-3", "zh": "（六）", "confidence": 65}
{"id": "35-1648-2-5", "zh": "临终的时刻到来时，", "confidence": 85}
{"id": "35-1649-2-5", "zh": "天神们安慰我说：", "confidence": 80}
{"id": "35-1650-2-5", "zh": "“有一辆套着千匹马的车，", "confidence": 75}
{"id": "35-1651-2-4", "zh": "已经为您这位贤者备好了。”", "confidence": 75}
{"id": "35-1652-2-3", "zh": "（七）", "confidence": 65}
{"id": "35-1653-2-6", "zh": "在最后一念生起的时候，", "confidence": 80}
{"id": "35-1654-2-5", "zh": "我忆念起自己的戒；", "confidence": 85}
{"id": "35-1655-2-5", "zh": "凭借那件做得很好的善业，", "confidence": 80}
{"id": "35-1656-2-4", "zh": "我往生到了三十三天。", "confidence": 85}
{"id": "35-1657-2-3", "zh": "（八）", "confidence": 65}
{"id": "35-1658-2-4", "zh": "我三十次成为天帝，", "confidence": 80}
{"id": "35-1659-2-3", "zh": "统治天界；", "confidence": 80}
{"id": "35-1660-2-4", "zh": "享受天上的快乐，", "confidence": 85}
{"id": "35-1661-2-4", "zh": "被天女们簇拥着。", "confidence": 85}
{"id": "35-1662-2-3", "zh": "（九）", "confidence": 65}
{"id": "35-1663-2-4", "zh": "我七十五次", "confidence": 80}
{"id": "35-1664-2-4", "zh": "成为转轮王；", "confidence": 85}
{"id": "35-1665-2-4", "zh": "统治广大地方的王位，", "confidence": 75}
{"id": "35-1666-2-4", "zh": "次数多得无法计算。", "confidence": 75}
{"id": "35-1667-2-3", "zh": "（十）", "confidence": 65}
{"id": "35-1668-2-5", "zh": "从天界死没以后，", "confidence": 80}
{"id": "35-1669-2-4", "zh": "受到白净善根的推动；", "confidence": 75}
{"id": "35-1670-2-5", "zh": "我出生在毗舍离城，", "confidence": 85}
{"id": "35-1671-2-4", "zh": "一个非常富有的大家族里。", "confidence": 85}
{"id": "35-1672-2-3", "zh": "（十一）", "confidence": 65}
{"id": "35-1673-2-4", "zh": "在进入雨安居的时候，", "confidence": 80}
{"id": "35-1674-2-4", "zh": "那时胜者的教法正光辉照耀；", "confidence": 75}
{"id": "35-1675-2-7", "zh": "我的母亲和父亲", "confidence": 85}
{"id": "35-1676-2-3", "zh": "受持了五学处。", "confidence": 85}
{"id": "35-1677-2-3", "zh": "（十二）", "confidence": 65}
{"id": "35-1678-2-6", "zh": "我一听到戒，", "confidence": 75}
{"id": "35-1679-2-5", "zh": "就忆念起自己的戒；", "confidence": 80}
{"id": "35-1680-2-4", "zh": "就在同一次坐着的时候，", "confidence": 75}
{"id": "35-1681-2-3", "zh": "证得了阿罗汉果。", "confidence": 85}
{"id": "35-1682-2-3", "zh": "（十三）", "confidence": 65}
{"id": "35-1683-2-5", "zh": "出生后五岁时，", "confidence": 80}
{"id": "35-1684-2-3", "zh": "我证得了阿罗汉果；", "confidence": 85}
{"id": "35-1685-2-4", "zh": "佛陀为我授了具足戒，", "confidence": 80}
{"id": "35-1686-2-4", "zh": "这位具眼者了知我的功德。", "confidence": 75}
{"id": "35-1687-2-3", "zh": "（十四）", "confidence": 65}
{"id": "35-1688-2-5", "zh": "我圆满地守护了", "confidence": 80}
{"id": "35-1689-2-3", "zh": "五学处之后；", "confidence": 80}
{"id": "35-1690-2-4", "zh": "从无量劫以来，", "confidence": 75}
{"id": "35-1691-2-5", "zh": "我从未堕入恶道。", "confidence": 80}
{"id": "35-1692-2-3", "zh": "（十五）", "confidence": 65}
{"id": "35-1693-2-4", "zh": "我享受了这样的荣耀，", "confidence": 80}
{"id": "35-1694-2-5", "zh": "全是凭借那些戒的力量；", "confidence": 80}
{"id": "35-1695-2-4", "zh": "即使称颂一千万劫，", "confidence": 75}
{"id": "35-1696-2-4", "zh": "也只能说出其中的一小部分。", "confidence": 80}
