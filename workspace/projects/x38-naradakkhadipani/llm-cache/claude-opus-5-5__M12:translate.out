{"id":"35-926-2-4","zh":"178.","confidence":95}
{"id":"35-927-2-6","zh":"应当把财富分成四份，","confidence":85}
{"id":"35-928-2-4","zh":"过在家生活的智者；","confidence":80}
{"id":"35-929-2-5","zh":"用一份来享用，","confidence":85}
{"id":"35-930-2-5","zh":"用两份来经营事业；","confidence":85}
