{"id": "21-1495-2-4", "zh": "454.", "confidence": 95}
{"id": "21-1496-2-4", "zh": "setaṭṭikā 是庄稼的病害（白穗病）；", "confidence": 70}
{"id": "21-1497-2-6", "zh": "kaṇa 与 kuṇḍaka 指米糠；", "confidence": 70}
{"id": "21-1498-2-16", "zh": "khala 是打谷场，也叫 dhaññakaraṇa；thamba（一本作 thambha）与 gumba 指草木等的丛。", "confidence": 75}
{"id": "21-1499-2-4", "zh": "455.", "confidence": 95}
{"id": "21-1500-2-9", "zh": "ayogga 与 musala 指杵，不用阴性；kulla 与 suppa 指簸箕，不用阴性；", "confidence": 80}
{"id": "21-1501-2-13", "zh": "uddhana 与 cullī（阴性）指灶；kilañja 与 kaṭa 指席子。", "confidence": 80}
{"id": "21-1502-2-4", "zh": "456.", "confidence": 95}
{"id": "21-1503-2-14", "zh": "kumbhī（阴性）、piṭhara、kuṇḍa、khaḷopī、ukkhali、thālī、ukhā 指锅釜；", "confidence": 75}
{"id": "21-1504-2-9", "zh": "kolamba 也是锅；maṇika、bhāṇaka 与 arañjara 指大水瓮。", "confidence": 65}
{"id": "21-1505-2-4", "zh": "457.", "confidence": 95}
{"id": "21-1506-2-11", "zh": "ghaṭa（阳性、中性两用）、kuṭa（不用阴性）、kumbha、kalasa、vāraka 指水罐；", "confidence": 75}
{"id": "21-1507-2-10", "zh": "kaṃsa 是吃饭用的钵；matta、patta 与 bhājana 指器皿。", "confidence": 75}
{"id": "21-1508-2-4", "zh": "458.", "confidence": 95}
{"id": "21-1509-2-9", "zh": "aṇḍupaka 与 cumbaṭaka 指头顶物品时垫的圈；sarāva 与 mallaka 指浅碟；", "confidence": 70}
{"id": "21-1510-2-10", "zh": "kaṭacchu（阳性）与 dabbī（阴性）指勺子；kusūla 又称 koṭṭha，指谷仓。", "confidence": 75}
{"id": "21-1511-2-4", "zh": "459.", "confidence": 95}
{"id": "21-1512-2-8", "zh": "sāka（不用阴性）与 ḍāka 指蔬菜；siṅgīvera 与 addaka 指生姜；", "confidence": 80}
{"id": "21-1513-2-11", "zh": "晒干的生姜叫 mahosadha；marica 与 kolaka 指胡椒。", "confidence": 80}
{"id": "21-1514-2-4", "zh": "460.", "confidence": 95}
{"id": "21-1515-2-8", "zh": "sovīra、kañjiya、āranāḷa、thusodaka 都指酸浆；", "confidence": 70}
{"id": "21-1516-2-9", "zh": "dhaññambila 与 biḷaṅga 也是酸浆；lavaṇa 又称 loṇa，指盐。", "confidence": 65}
{"id": "21-1517-2-4", "zh": "461.", "confidence": 95}
{"id": "21-1518-2-9", "zh": "sāmudda（海盐）、sindhava（岩盐，不用阴性）、kāḷaloṇa（黑盐）、ubbhida（土盐）", "confidence": 70}
{"id": "21-1519-2-16", "zh": "以及 biḷaka（一本作 biḷāla），这五种是盐的类别。", "confidence": 75}
{"id": "21-1520-2-4", "zh": "462.", "confidence": 95}
{"id": "21-1521-2-10", "zh": "guḷa（粗糖块）、phāṇita（糖浆）、khaṇḍa（糖块）、macchaṇḍī（冰糖）、sakkharā（砂糖），", "confidence": 65}
{"id": "21-1522-2-8", "zh": "这些是甘蔗的制品；guḷa 又称 visakaṇṭaka。", "confidence": 70}
{"id": "21-1523-2-4", "zh": "463.", "confidence": 95}
{"id": "21-1524-2-12", "zh": "lājā 与 akkhata 指炒米；dhānā 指炒过的大麦；", "confidence": 75}
{"id": "21-1525-2-11", "zh": "不成团的炒麦粉叫 mantha；pūpa、apūpa 与 piṭṭhaka 指糕饼。", "confidence": 70}
{"id": "21-1526-2-4", "zh": "464.", "confidence": 95}
{"id": "21-1527-2-8", "zh": "bhattakāra、sūpakāra、sūda、āḷārika，", "confidence": 80}
{"id": "21-1528-2-10", "zh": "以及 odanika 与 rasaka，都指厨师；sūpa 与 byañjana 指菜汤、配菜。", "confidence": 75}
{"id": "21-1529-2-4", "zh": "465.", "confidence": 95}
{"id": "21-1530-2-13", "zh": "odana、kura、bhatta 指饭，bhikkhā 也是；anna 与 asana，", "confidence": 70}
{"id": "21-1531-2-5", "zh": "āhāra、bhojana、ghāsa 指食物；", "confidence": 80}
{"id": "21-1532-2-5", "zh": "taraḷa 与 yāgu（阴性）指粥。", "confidence": 80}
{"id": "21-1533-2-4", "zh": "466.", "confidence": 95}
{"id": "21-1534-2-11", "zh": "khajja（嚼食）、bhojja（软食）、leyya（舔食）、peyya（饮料），这是食物的四种；", "confidence": 80}
{"id": "21-1535-2-7", "zh": "nissāva 与 ācāma 指米汤，", "confidence": 70}
{"id": "21-1536-2-5", "zh": "ālopa 与 kabaḷa 指一口饭团。", "confidence": 80}
{"id": "21-1537-2-4", "zh": "467.", "confidence": 95}
{"id": "21-1538-2-7", "zh": "maṇḍa（不用阴性）指汁液中最精华的部分；vighāsa 指吃剩的食物；", "confidence": 75}
{"id": "21-1539-2-10", "zh": "vighāsāda 与 damaka 指吃残食的人；pipāsā 与 tasana 指口渴。", "confidence": 75}
{"id": "21-1540-2-4", "zh": "468.", "confidence": 95}
{"id": "21-1541-2-9", "zh": "khuddā 与 jighacchā 指饥饿；肉汤的滋味叫 paṭicchādaniya；", "confidence": 70}
{"id": "21-1542-2-9", "zh": "udreka 与 uggāra 指打嗝；sohicca、titti、tappana 指饱足。", "confidence": 75}
{"id": "21-1543-2-4", "zh": "469.", "confidence": 95}
{"id": "21-1544-2-8", "zh": "kāma、iṭṭha、nikāma、pariyatta、yathacchita 指随心所欲、尽量满足；", "confidence": 70}
{"id": "21-1545-2-9", "zh": "kayavikkayika、satthavāha、āpaṇika、vāṇija 指商人。", "confidence": 75}
{"id": "21-1546-2-4", "zh": "470.", "confidence": 95}
{"id": "21-1547-2-5", "zh": "vikkayika 与 vikketā 指卖方，", "confidence": 80}
{"id": "21-1548-2-6", "zh": "kayika 与 kāyika 指买方；", "confidence": 80}
{"id": "21-1549-2-9", "zh": "uttamaṇṇa 与 dhanika 指债主；adhamaṇṇa 与 iṇāyika 指欠债人。", "confidence": 80}
{"id": "21-1550-2-4", "zh": "471.", "confidence": 95}
{"id": "21-1551-2-11", "zh": "uddhāra 又称 iṇa，指债务；mūla 与 pābhata 指本钱；", "confidence": 75}
{"id": "21-1552-2-8", "zh": "saccāpana 与 saccaṃkāra 指定金；vikkeyya 与 paṇiya 指货物，三性通用。", "confidence": 70}
{"id": "21-1553-2-4", "zh": "472.", "confidence": 95}
{"id": "21-1554-2-10", "zh": "paṭidāna 与 parivatta 指交换；nyāsa 与 upanidhi 指寄存物。", "confidence": 75}
{"id": "21-1555-2-4", "zh": "473.", "confidence": 95}
{"id": "21-1556-2-8", "zh": "从一到十八的数词用来指被计数的事物，三性通用；", "confidence": 70}
{"id": "21-1557-2-10", "zh": "二十以上的数词，无论指数目本身还是被计数的事物，都用单数；", "confidence": 65}
{"id": "21-1558-2-8", "zh": "区分各组时也用复数；这些数直到九十都是阴性。", "confidence": 60}
{"id": "21-1559-2-4", "zh": "474.", "confidence": 95}
{"id": "21-1560-2-15", "zh": "sata（百）、sahassa（千）、niyuta（有些本子作 nahuta 或 nayuta）、lakkha、koṭi、pakoṭi，", "confidence": 70}
{"id": "21-1561-2-8", "zh": "koṭipakoṭi、nahuta，以及 ninnahuta，", "confidence": 75}
{"id": "21-1562-2-4", "zh": "475.", "confidence": 95}
{"id": "21-1563-2-15", "zh": "akkhobhaṇī（阴性；一本作 akkhobhiṇī）、bindu、abbuda、nirabbuda，", "confidence": 75}
{"id": "21-1564-2-9", "zh": "ahaha、ababa、ṭaṭa、sogandhika、uppala，", "confidence": 75}
{"id": "21-1565-2-4", "zh": "476.", "confidence": 95}
{"id": "21-1566-2-8", "zh": "kumuda、puṇḍarīka、paduma，以及 kathāna，", "confidence": 75}
{"id": "21-1567-2-11", "zh": "mahākathāna、asaṅkhyeyya；这些数词中，sata 等一律用中性。", "confidence": 50}
{"id": "21-1568-2-4", "zh": "477.", "confidence": 95}
{"id": "21-1569-2-7", "zh": "到 koṭi 为止，各数依次十倍递增；从 koṭi 起，各数依次以千万倍递增；", "confidence": 55}
{"id": "21-1570-2-6", "zh": "第四个减去一半叫 aḍḍhuḍḍha（三个半），", "confidence": 65}
{"id": "21-1571-2-5", "zh": "第三个减去一半同样叫 aḍḍhatiya（两个半）。", "confidence": 60}
