{"id": "21-1811-2-10", "zh": "从树根起到分枝处为止的那一段树身，叫作 khandha（树干）；", "confidence": 75}
{"id": "21-1812-2-11", "zh": "树洞叫作 koṭara（非阴性）；木材叫作 kaṭṭha，也叫 dāru。", "confidence": 78}
{"id": "21-1814-2-11", "zh": "树根叫作 bunda、mūla、pāda；树桩叫作 saṅku，也叫 khāṇu（非阴性）；", "confidence": 75}
{"id": "21-1815-2-10", "zh": "块根叫作 karahāṭa，也叫 kanda；树梢叫作 kaḷīra、matthaka。", "confidence": 65}
{"id": "21-1817-2-10", "zh": "花穗叫作 vallarī、mañjarī（阴性）；藤叫作 vallī，也叫 latā；", "confidence": 65}
{"id": "21-1818-2-10", "zh": "没有主干的丛生植物叫作 thambha、gumba；蔓生植物叫作 latā、virū、patāninī。", "confidence": 62}
{"id": "21-1820-2-11", "zh": "菩提树叫作 assattha、bodhi（两性通用）；榕树叫作 nigrodha，也叫 vaṭa；", "confidence": 80}
{"id": "21-1821-2-10", "zh": "木苹果树叫作 kabiṭṭha、kapittha；优昙钵树叫作 yaññaṅga，也叫 udumbara。", "confidence": 78}
{"id": "21-1823-2-7", "zh": "羊蹄甲树叫作 koviḷāra、yugapatta；uddāla 又叫 vātaghātaka；", "confidence": 60}
{"id": "21-1824-2-7", "zh": "腊肠树叫作 rājarukkha、katamāla、indīvara、byādhighātaka。", "confidence": 55}
{"id": "21-1826-2-10", "zh": "香橼树叫作 dantasaṭha、jambhīra；鱼木叫作 varaṇa，也叫 kareri；", "confidence": 62}
{"id": "21-1827-2-10", "zh": "刺桐叫作 kiṃsuka、pālibhadda；水杨叫作 vañjula，也叫 vetasa。", "confidence": 55}
{"id": "21-1829-2-7", "zh": "槟榔青叫作 ambāṭaka、pītanaka；蜜树叫作 madhuka，也叫 madhuddума。", "confidence": 60}
{"id": "21-1830-2-10", "zh": "又，牙刷树叫作 guḷaphala、pīlu；辣木叫作 sobhañjana，也叫 siggu。", "confidence": 65}
{"id": "21-1832-2-8", "zh": "七叶树叫作 sattapaṇṇi、chattapaṇṇa；tinisa 又叫 atimuttaka；", "confidence": 60}
{"id": "21-1833-2-7", "zh": "紫铆树叫作 kiṃsuka，也叫 palāsa；", "confidence": 68}
{"id": "21-1834-2-5", "zh": "无患子树叫作 ariṭṭha、phenila。", "confidence": 70}
{"id": "21-1836-2-9", "zh": "木橘树叫作 mālūra、beluva、billa；胡桐叫作 punnāga，也叫 kesara；", "confidence": 68}
{"id": "21-1837-2-11", "zh": "山矾树叫作 sālava，也叫 lodda；piyāla 又叫 sannakaddu。", "confidence": 58}
{"id": "21-1839-2-6", "zh": "八角枫叫作 likocaka，也叫 aṅkola；", "confidence": 58}
{"id": "21-1840-2-5", "zh": "又，没药树叫作 guggulu、kosika；", "confidence": 58}
{"id": "21-1841-2-6", "zh": "芒果树叫作 amba、cūta；其中一种叫作 saha，", "confidence": 62}
{"id": "21-1842-2-4", "zh": "又叫 sahakāra，带有香气。", "confidence": 62}
{"id": "21-1844-2-10", "zh": "白芒果树叫作 puṇḍarīka，也叫 setamba；破布木叫作 selu，也叫 bahuvāraka；", "confidence": 60}
{"id": "21-1845-2-9", "zh": "石梓叫作 sepaṇṇī、kāsmirī；又，枣树叫作 kolī，也叫 badarī（阴性）；", "confidence": 62}
{"id": "21-1847-2-10", "zh": "枣树又叫 kola（非阴性）、badara；毕洛叉榕叫作 pilakkha，也叫 pippalī（阴性）；", "confidence": 55}
{"id": "21-1848-2-8", "zh": "波吒厘树叫作 pāṭalī、kaṇhavantā；sādukaṇṭa 又叫 vikaṅkata。", "confidence": 60}
{"id": "21-1850-2-8", "zh": "乌木柿叫作 tinduka、kāḷakkhandha；timbarūsaka 又叫 timbarū；", "confidence": 58}
{"id": "21-1851-2-8", "zh": "橘树叫作 erāvata，也叫 nāraṅga；kulaka 又叫 kākatinduka。", "confidence": 58}
{"id": "21-1853-2-9", "zh": "团花树叫作 kadamba、piyaka、nīpa；肉托果叫作 bhallī、bhallātaka（三性通用）；", "confidence": 62}
{"id": "21-1854-2-9", "zh": "柽柳叫作 jhāvuka、picula；又，提拉迦树叫作 tilaka、khuraka。", "confidence": 60}
{"id": "21-1856-2-9", "zh": "酸豆树叫作 ciñcā、tintiṇī；又，gaddabhaṇḍa 叫作 kapītana；", "confidence": 60}
{"id": "21-1857-2-7", "zh": "娑罗树叫作 sāla、assakaṇṇa、sajja；", "confidence": 70}
{"id": "21-1858-2-5", "zh": "阿周那树叫作 ajjuna、kakudha。", "confidence": 68}
{"id": "21-1860-2-10", "zh": "目真邻陀树叫作 nicula、mucalinda；同样，nīpa 又叫 piyaka；", "confidence": 62}
{"id": "21-1861-2-5", "zh": "印度紫檀叫作 asana、pītasāla；", "confidence": 58}
{"id": "21-1862-2-5", "zh": "golīsa 又叫 jhāṭala。", "confidence": 50}
{"id": "21-1864-2-8", "zh": "乳汁树叫作 khīrikā、rājāyatana；kumbhī 又叫 kumudikā；", "confidence": 52}
{"id": "21-1865-2-16", "zh": "槟榔树叫作 yūpa（异读作 pūga），也叫 kamuka；又，paṭṭi 叫作 lākhāpasādana。", "confidence": 55}
{"id": "21-1867-2-8", "zh": "苦行者树叫作 iṅgudī、tāpasataru；桦树叫作 bhujapatta，也叫 ābhujī；", "confidence": 62}
{"id": "21-1868-2-8", "zh": "木棉叫作 picchilā、simbalī（两性通用）；rocana 又叫 koṭasimbalī。", "confidence": 58}
{"id": "21-1870-2-9", "zh": "臭树叫作 pakiriya、pūtika；rohī 又叫 rohitaka；", "confidence": 55}
{"id": "21-1871-2-10", "zh": "蓖麻叫作 eraṇḍa，也叫 āmaṇḍa；又，舍弥树叫作 sattuphalā、samī。", "confidence": 62}
{"id": "21-1873-2-8", "zh": "水黄皮叫作 nattamāla、karañja；儿茶树叫作 khadira、dantadhāvana；", "confidence": 65}
{"id": "21-1874-2-9", "zh": "白儿茶叫作 somavakka，也叫 kadara；salla 又叫 madana。", "confidence": 52}
{"id": "21-1876-2-9", "zh": "又，乳香树叫作 indasāla、sallakī、khāraka；", "confidence": 55}
{"id": "21-1877-2-9", "zh": "雪松叫作 devadāru、bhaddadāru；瞻波迦树叫作 campeyya，也叫 campaka。", "confidence": 68}
{"id": "21-1879-2-8", "zh": "波罗蜜树叫作 panasa、kaṇṭakiphala；诃梨勒叫作 abhayā，也叫 harītakī；", "confidence": 72}
{"id": "21-1880-2-10", "zh": "毗醯勒叫作 akkha、vibhītaka（三性通用）；庵摩勒叫作 amatā、āmalakī（三性通用）。", "confidence": 70}
{"id": "21-1882-2-8", "zh": "猴面果树叫作 labuja、likuca；又，迦尼迦罗树叫作 kaṇikāra、dumuppala；", "confidence": 62}
{"id": "21-1883-2-11", "zh": "印度楝叫作 nimba、ariṭṭha、pucimanda；石榴叫作 karaka，也叫 dāḷima。", "confidence": 68}
{"id": "21-1885-2-10", "zh": "长叶松叫作 sarala、pūtikaṭṭha；印度黄檀叫作 kapilā，也叫 siṃsapā；", "confidence": 60}
{"id": "21-1886-2-10", "zh": "粟叫作 sāmā、piyaṅgu、kaṅgu；合欢树叫作 sirīsa，也叫 bhaṇḍila。", "confidence": 60}
