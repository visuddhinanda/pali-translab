{"id":"21-1653-2-5","zh":"vasso、aja、chagalaka：山羊，","confidence":70}
{"id":"21-1654-2-6","zh":"oṭṭha、karabha：骆驼；","confidence":85}
{"id":"21-1655-2-11","zh":"gadrabha、khara 称为驴；uraṇī、ajī、ajā：母羊。","confidence":75}
{"id":"21-1656-2-4","zh":"以上是吠舍品。","confidence":90}
{"id":"21-1658-2-9","zh":"sudda、antavaṇṇa、vasala：首陀罗；māgadha 等是混血种姓（saṃkiṇṇa）；","confidence":75}
{"id":"21-1659-2-8","zh":"māgadha 是首陀罗男子与刹帝利女子所生的人；ugga 是刹帝利男子与首陀罗女子所生的人。","confidence":70}
{"id":"21-1661-2-7","zh":"sūta 是刹帝利男子与婆罗门女子所生的人；kāru、sippika（阳性）：工匠；","confidence":65}
{"id":"21-1662-2-8","zh":"同类工匠结成的团体称为 seṇī，阳性、阴性两用。","confidence":65}
{"id":"21-1664-2-9","zh":"木匠、织工、洗染工、理发师，","confidence":80}
{"id":"21-1665-2-8","zh":"第五是皮革匠——这五种就是工匠（kāru）。","confidence":80}
{"id":"21-1667-2-8","zh":"tacchaka、vaḍḍhakī、palagaṇḍa、thapati，","confidence":70}
{"id":"21-1668-2-9","zh":"还有 rathakāra：木匠；suvaṇṇakāra、nāḷindhama：金匠。","confidence":60}
{"id":"21-1670-2-4","zh":"tantavāya、pesakāra：织工，","confidence":85}
{"id":"21-1671-2-5","zh":"mālākāra、mālika：花匠；","confidence":85}
{"id":"21-1672-2-5","zh":"kumbhakāra、kulāla：陶匠，","confidence":85}
{"id":"21-1673-2-5","zh":"tunnavāya、sūcika：裁缝。","confidence":80}
{"id":"21-1675-2-8","zh":"cammakāra、rathakāra：皮革匠；kappaka、nahāpita：理发师；","confidence":70}
{"id":"21-1676-2-7","zh":"raṅgājīva、cittakāra：画师；pukkusa、pupphachaḍḍaka：清除污秽的人。","confidence":65}
{"id":"21-1678-2-9","zh":"vena、vilīvakāra、naḷakāra 三者同义：竹篾匠；","confidence":70}
{"id":"21-1679-2-4","zh":"cundakāra、bhamakāra：旋工，","confidence":65}
{"id":"21-1680-2-4","zh":"kammāra、lohakāraka：铁匠。","confidence":80}
{"id":"21-1682-2-8","zh":"ninnejaka、rajaka：洗衣工；nettika、udahāraka：运水人；","confidence":60}
{"id":"21-1683-2-9","zh":"vīṇāvādī、veṇika：弹琵琶的乐师；usukāra、usuvaḍḍhakī：造箭匠。","confidence":65}
{"id":"21-1685-2-5","zh":"veṇudhama、veṇavika：吹笛人，","confidence":75}
{"id":"21-1686-2-11","zh":"pāṇivāda、pāṇigha（有的版本作 pāṇiya）：击掌打拍子的人；","confidence":55}
{"id":"21-1687-2-7","zh":"pūpiya、pūpapaṇiya：卖饼的人；soṇḍika、majjavikkayī：卖酒的人。","confidence":80}
{"id":"21-1689-2-10","zh":"māyā、sambarī：幻术；māyākāra、indajālika：幻术师。","confidence":75}
{"id":"21-1691-2-9","zh":"orabbhika、sūkarika、māgavika 以及 sākuṇika，","confidence":75}
{"id":"21-1692-2-13","zh":"依次是以杀羊、杀猪、杀鹿、杀鸟为生的人。","confidence":80}
{"id":"21-1694-2-5","zh":"vāgurika、jālika：张网捕猎的人，","confidence":70}
{"id":"21-1695-2-5","zh":"bhāravāha、bhārika：挑夫；","confidence":80}
{"id":"21-1696-2-10","zh":"vetanika、bhataka：雇工；kammakara、kiṃkara：仆役；","confidence":70}
{"id":"21-1697-2-10","zh":"dāsa、ceṭaka、pessa、bhacca、paricārika：奴仆。","confidence":75}
{"id":"21-1699-2-9","zh":"家中所生的、用钱买来的、自愿投身为奴的，","confidence":70}
{"id":"21-1700-2-9","zh":"以及战俘被带来做奴隶的——奴隶就这样分为四种。","confidence":60}
{"id":"21-1702-2-6","zh":"不是奴隶的自由人称为 bhujissa；","confidence":80}
{"id":"21-1703-2-5","zh":"nīca、jamma、nihīnaka：卑贱的人；","confidence":80}
{"id":"21-1704-2-4","zh":"nikkosajja、akilāsu：勤勉的人，","confidence":75}
{"id":"21-1705-2-6","zh":"manda、alasa：懒惰的人。","confidence":75}
{"id":"21-1707-2-9","zh":"sapāka、caṇḍāla、mātaṅga、sapaca：旃陀罗；","confidence":80}
{"id":"21-1708-2-9","zh":"他们的分支是蔑戾车（milakkha）诸族，如 kirāta、savara 等。","confidence":70}
{"id":"21-1710-2-5","zh":"nesāda、luddaka、byādha：猎人，","confidence":80}
{"id":"21-1711-2-5","zh":"migava、migabyadha：猎鹿人；","confidence":65}
{"id":"21-1712-2-10","zh":"sārameyya、sunakha、suna、soṇa、kukkura，","confidence":80}
{"id":"21-1714-2-5","zh":"svāna、suvāna、sāḷūra，","confidence":80}
{"id":"21-1715-2-7","zh":"sūna、sāna，以及 sā（阳性）：狗；","confidence":75}
{"id":"21-1716-2-9","zh":"发了疯等的狗称为 **aḷakka**。","confidence":70}
{"id":"21-1718-2-10","zh":"拴狗的绳子称为 gaddūla；诱捕猎物用的媒兽称为 dīpaka、cetaka；","confidence":55}
{"id":"21-1719-2-18","zh":"bandhana、gaṇṭhi、pāsa：绳结、套索；vāgurā（锡兰本与复注作 vākarā）、migabandhanī：捕兽网。","confidence":60}
{"id":"21-1721-2-9","zh":"kuveṇī（阴性）、kumīna：捕鱼笼；ānaya、jāla：网；","confidence":60}
{"id":"21-1722-2-8","zh":"āghātana、vadhaṭṭhāna：屠宰场；sūnā、adhikoṭṭana：屠宰用的砧板。","confidence":60}
{"id":"21-1724-2-6","zh":"takkara、mosaka、cora，","confidence":80}
{"id":"21-1725-2-6","zh":"thena、ekāgārika 同义：盗贼；","confidence":70}
{"id":"21-1726-2-5","zh":"theyya、corikā、mosa：偷盗，","confidence":75}
{"id":"21-1727-2-4","zh":"vema、vāyanadaṇḍaka：织布用的打纬杆。","confidence":55}
{"id":"21-1729-2-9","zh":"sutta、tantu（阳性）、tanta：线；pottha 指泥塑等工艺制成的像；","confidence":60}
{"id":"21-1730-2-6","zh":"pañcālikā、potthalikā：用布、象牙等做成的人偶。","confidence":65}
