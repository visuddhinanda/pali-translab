{"id": "21-2360-2-4", "zh": "719.", "confidence": 95}
{"id": "21-2361-2-5", "zh": "身体的左侧叫做 vāma、sabya；", "confidence": 70}
{"id": "21-2361-6-9", "zh": "右侧则叫做 apasabya、dakkhiṇa；", "confidence": 80}
{"id": "21-2362-2-10", "zh": "apasabya 也指违逆（paṭikūla）；gahana 与 kalila 同义，指深密难入。", "confidence": 70}
{"id": "21-2363-2-4", "zh": "720.", "confidence": 95}
{"id": "21-2364-2-10", "zh": "高低不一叫 uccāvaca，又指种类繁多（bahubheda）；混杂拥挤叫 saṃkiṇṇa、ākiṇṇa、saṃkula；", "confidence": 75}
{"id": "21-2365-2-10", "zh": "熟练能干的人叫 katahattha、kusala、pavīṇa、abhiñña、sikkhita。", "confidence": 80}
{"id": "21-2366-2-4", "zh": "721.", "confidence": 95}
{"id": "21-2367-2-10", "zh": "还有 nipuṇa、paṭu、cheka、cātura、dakkha、pesala，也都指精通熟练的人；", "confidence": 80}
{"id": "21-2368-2-11", "zh": "愚笨的人叫 bāla、dattu、jala、mūḷha、manda、aviññū、bālisa。", "confidence": 60}
{"id": "21-2369-2-4", "zh": "722.", "confidence": 95}
{"id": "21-2370-2-8", "zh": "有福的人叫 puññavā、sukatī、dhañña；精进有毅力的人叫 mahussāha、mahādhiti；", "confidence": 80}
{"id": "21-2371-2-9", "zh": "贪欲大的人叫 mahātaṇha、mahiccha；心地仁厚的人叫 hadayī、hadayālu。", "confidence": 75}
{"id": "21-2372-2-4", "zh": "723.", "confidence": 95}
{"id": "21-2373-2-9", "zh": "心情愉快的人叫 sumana、haṭṭhacitta；心情不好的人叫 dummana、vimana；", "confidence": 85}
{"id": "21-2374-2-8", "zh": "慷慨好施的人叫 vadāniya、vadaññū、dānasoṇḍa、bahuppada。", "confidence": 85}
{"id": "21-2375-2-4", "zh": "724.", "confidence": 95}
{"id": "21-2376-2-5", "zh": "有名望的人叫 khyāta、patīta、paññāta、", "confidence": 85}
{"id": "21-2377-2-5", "zh": "abhiññāta、pathita、suta、", "confidence": 85}
{"id": "21-2378-2-9", "zh": "vissuta、vidita、pasiddha、pākaṭa。", "confidence": 85}
{"id": "21-2379-2-4", "zh": "725.", "confidence": 95}
{"id": "21-2380-2-12", "zh": "主人叫 issara、nāyaka、sāmī、patī、īsa、adhipatī、pabhū；", "confidence": 85}
{"id": "21-2381-2-8", "zh": "也叫 ayya、adhipa、adhibhū、netā；", "confidence": 85}
{"id": "21-2382-2-8", "zh": "富人则叫 ibbha、aḍḍha，还有 dhanī。", "confidence": 85}
{"id": "21-2383-2-4", "zh": "726.", "confidence": 95}
{"id": "21-2384-2-9", "zh": "值得布施的人叫 dānāraha、dakkhiṇeyya；慈爱的人叫 siniddha、vacchala；", "confidence": 85}
{"id": "21-2385-2-4", "zh": "善于审察的人叫 parikkhaka、kāraṇika；", "confidence": 80}
{"id": "21-2386-2-6", "zh": "专注投入的人叫 āsatta、tappara。", "confidence": 80}
{"id": "21-2387-2-4", "zh": "727.", "confidence": 95}
{"id": "21-2388-2-9", "zh": "有悲心的人叫 kāruṇika、dayālu、sūrata；ussuka 则指", "confidence": 65}
{"id": "21-2389-2-8", "zh": "热衷于追求所愿之事的人；做事拖延的人叫 dīghasutta、cirakriya。", "confidence": 70}
{"id": "21-2390-2-4", "zh": "728.", "confidence": 95}
{"id": "21-2391-2-9", "zh": "依附他人的人叫 parādhīna、parāyatta；隶属于人的叫 āyatta、santaka、", "confidence": 75}
{"id": "21-2392-2-10", "zh": "pariggaha、adhīna；随心所欲的人叫 sacchanda、serī。", "confidence": 75}
{"id": "21-2393-2-4", "zh": "729.", "confidence": 95}
{"id": "21-2394-2-8", "zh": "做事不加思量的人叫 jamma；贪得无厌的人叫 lolupa；", "confidence": 75}
{"id": "21-2395-2-7", "zh": "贪婪的人叫 giddha、luddha、lola；", "confidence": 85}
{"id": "21-2396-2-6", "zh": "做事迟钝的人叫 kuṇṭha、manda。", "confidence": 80}
{"id": "21-2397-2-4", "zh": "730.", "confidence": 95}
{"id": "21-2398-2-9", "zh": "贪爱欲乐的人叫 kāmayitā、kamitā、kāmana、kāmī、kāmuka；", "confidence": 85}
{"id": "21-2399-2-6", "zh": "沉溺酒色的人叫 soṇḍa、matta；顺从听话的人叫 vidheyya、", "confidence": 70}
{"id": "21-2400-2-5", "zh": "assava、subbaca，这几个词同义。", "confidence": 75}
{"id": "21-2401-2-4", "zh": "731.", "confidence": 95}
{"id": "21-2402-2-9", "zh": "大胆而有辩才的人叫 pagabbha、paṭibhāyutta；胆小的人叫 bhīsīla、bhīru、bhīruka、", "confidence": 80}
{"id": "21-2403-2-12", "zh": "adhīra（注疏本作 avīra）、kātara；", "confidence": 75}
{"id": "21-2404-2-5", "zh": "生性好杀的人叫 hiṃsāsīla、ghātuka。", "confidence": 85}
{"id": "21-2405-2-4", "zh": "732.", "confidence": 95}
{"id": "21-2406-2-12", "zh": "易怒的人叫 kodhana、rosana（锡兰本作 dosana）、kopī；", "confidence": 80}
{"id": "21-2407-2-4", "zh": "极易发怒的人叫 caṇḍa；", "confidence": 85}
{"id": "21-2408-2-9", "zh": "能忍耐的人叫 sahana、khamana、khantā、titikkhavā、khantimā。", "confidence": 85}
{"id": "21-2409-2-4", "zh": "733.", "confidence": 95}
{"id": "21-2410-2-19", "zh": "有信心的人叫 saddhāyutta、saddhālu；显赫有声望的人叫 dhajavā、dhajālu（另本作：知羞耻的人叫 lajjālu、lajjavā）；", "confidence": 60}
{"id": "21-2411-2-9", "zh": "贪睡的人叫 niddālu、niddāsīla；光亮的叫 bhassara、bhāsura。", "confidence": 80}
{"id": "21-2412-2-4", "zh": "734.", "confidence": 95}
{"id": "21-2413-2-11", "zh": "裸身的人叫 nagga、digambara、avattha；贪吃的人叫 ghasmara、bhakkhaka；", "confidence": 85}
{"id": "21-2414-2-11", "zh": "既不会说、也不会听的人叫 eḷamūga。", "confidence": 80}
{"id": "21-2415-2-4", "zh": "735.", "confidence": 95}
{"id": "21-2416-2-9", "zh": "mukhara、dummukha、abaddhamukha，都指说话难听、口无遮拦的人；", "confidence": 75}
{"id": "21-2417-2-10", "zh": "话多惹人厌的人叫 vācāla；善于言说的人则叫 vada。", "confidence": 70}
{"id": "21-2418-2-4", "zh": "736.", "confidence": 95}
{"id": "21-2419-2-5", "zh": "自己的叫 nija、saka、attaniya；", "confidence": 85}
{"id": "21-2420-2-7", "zh": "惊奇叫 vimhaya、acchariya、abbhuta；", "confidence": 85}
{"id": "21-2421-2-5", "zh": "惊慌失措的人叫 vihattha、byākula；", "confidence": 80}
{"id": "21-2422-2-4", "zh": "图谋杀害他人的人叫 ātatāyī。", "confidence": 80}
{"id": "21-2423-2-4", "zh": "737.", "confidence": 95}
{"id": "21-2424-2-11", "zh": "应被斩首的人叫 vajjha；奸诈不正直的人叫 nikata、saṭha、anuju；", "confidence": 80}
{"id": "21-2425-2-5", "zh": "在耳边进谗言的人叫 sūcaka、pisuṇa；", "confidence": 80}
{"id": "21-2426-2-6", "zh": "骗子叫 japa、dhutta、vañcaka。", "confidence": 70}
{"id": "21-2427-2-4", "zh": "738.", "confidence": 95}
{"id": "21-2428-2-10", "zh": "一个人不加审思就去做事，去做杀戮、捆绑之类的事，", "confidence": 80}
{"id": "21-2429-2-8", "zh": "因为他做事不加判断，就应当知道他是**轻率者**（capala）。", "confidence": 80}
{"id": "21-2430-2-4", "zh": "739.", "confidence": 95}
{"id": "21-2431-2-9", "zh": "吝啬的人叫 khudda、kadariya、thaddha、maccharī、kapaṇa；", "confidence": 80}
{"id": "21-2432-2-9", "zh": "贫穷的人叫 akiñcana、dalidda、dīna、niddhana、duggata。", "confidence": 85}
{"id": "21-2433-2-4", "zh": "740.", "confidence": 95}
{"id": "21-2434-2-6", "zh": "出乎意料地得到的成就，叫做 kākatāliya（乌鸦与棕榈果）；", "confidence": 75}
{"id": "21-2435-2-9", "zh": "乞求的人叫 yācanaka、atthī、yācaka、vanibbaka。", "confidence": 85}
{"id": "21-2436-2-4", "zh": "741.", "confidence": 95}
{"id": "21-2437-2-8", "zh": "卵生（aṇḍaja）的是鸟、蛇等；胎生（jalābuja）的是人等；", "confidence": 85}
{"id": "21-2438-2-9", "zh": "湿生（sedaja）的是虫、蚊虻等；化生（opapātika）的是天神等。", "confidence": 85}
