{"id": "21-3775-2-11", "zh": "iṅgha、handa 表示催促；ārā、dūra 和 ārakā 表示远离。", "confidence": 75}
{"id": "21-3776-2-13", "zh": "parammukhā 和 raho 表示背地、暗中；sammukhā、āvi 和 pātu 表示当面、公开。", "confidence": 75}
{"id": "21-3778-2-10", "zh": "appeva、appevanāma 和 nu 用在表示疑问的意思上；", "confidence": 75}
{"id": "21-3779-2-12", "zh": "iti、itthaṃ、evaṃ 用于举例说明，kathañci 表示艰难。", "confidence": 70}
{"id": "21-3781-2-6", "zh": "hā 表示悲叹，sacchi 表示亲眼现见，", "confidence": 75}
{"id": "21-3782-2-6", "zh": "dhuvaṃ 表示坚定和确定；", "confidence": 75}
{"id": "21-3783-2-12", "zh": "tiro 表示横向；duṭṭhu 和 ku 用来表示鄙视。", "confidence": 70}
{"id": "21-3785-2-16", "zh": "suvatthi 用于祝福的意思，dhī（某本作 dhi）用来表示责备；", "confidence": 70}
{"id": "21-3786-2-11", "zh": "kuhiñcanaṃ、kuhiṃ、kutra、kuttha、kattha、kahaṃ、kva，都表示“哪里”。", "confidence": 65}
{"id": "21-3788-2-12", "zh": "iha、idha、atra、ettha、attha 表示“这里”，", "confidence": 70}
{"id": "21-3789-2-5", "zh": "sabbatra、sabbadhi 表示“到处”；", "confidence": 75}
{"id": "21-3790-2-10", "zh": "kadā、kudācanaṃ 表示“何时”；tadāni 和 tadā 同义，表示“那时”。", "confidence": 70}
{"id": "21-3792-2-10", "zh": "用于动作的开始、强烈、生起、渡过、满足，", "confidence": 50}
{"id": "21-3793-2-14", "zh": "差遣、统领、喜悦、布施、供养、最上、寂静，", "confidence": 50}
{"id": "21-3794-2-4", "zh": "1163.", "confidence": 55}
{"id": "21-3795-2-11", "zh": "看见、专注、执着、称赞、行去、清净，", "confidence": 80}
{"id": "21-3796-2-12", "zh": "伤害、方式、内部、没有、分离、部分；", "confidence": 45}
{"id": "21-3797-2-10", "zh": "前缀 pa 还用于方位、希求、坚定等意思。", "confidence": 60}
{"id": "21-3799-2-9", "zh": "parā 这个词用于衰退、失败、行去，", "confidence": 65}
{"id": "21-3800-2-8", "zh": "也用于强烈、逆反、勇进、触摸等意思。", "confidence": 55}
{"id": "21-3802-2-10", "zh": "无余、没有、舍弃、强烈、解脱、聚集，", "confidence": 50}
{"id": "21-3803-2-11", "zh": "房舍、指示、譬喻、低劣、明净、出离、越过，", "confidence": 40}
{"id": "21-3805-2-9", "zh": "看见、终结、出去、下方、确定，", "confidence": 50}
{"id": "21-3806-2-10", "zh": "邻近、束缚、善巧、内部、止息，", "confidence": 50}
{"id": "21-3808-2-9", "zh": "以及显现、分离、禁止等意思上，可以见到 ni；", "confidence": 60}
{"id": "21-3809-2-10", "zh": "而在取出、遮蔽等意思上，则用 nī。", "confidence": 60}
{"id": "21-3811-2-9", "zh": "向上的动作、分离、获得、满足、成就，", "confidence": 40}
{"id": "21-3812-2-8", "zh": "显现、越过、没有、强大、显示，", "confidence": 50}
{"id": "21-3813-2-10", "zh": "善巧、最上、述说、能力、解脱等意思上，用 u。", "confidence": 50}
{"id": "21-3815-2-11", "zh": "du 用于可鄙、轻微、丑陋、不美，", "confidence": 50}
{"id": "21-3816-2-12", "zh": "也用于没有、不成功、艰难、不喜等意思。", "confidence": 55}
{"id": "21-3818-2-8", "zh": "saṃ 用于聚合、简略、周遍、成就，", "confidence": 60}
{"id": "21-3819-2-9", "zh": "正确、强烈、共同、希求、面向、会合，", "confidence": 45}
{"id": "21-3820-2-7", "zh": "安排、生起、供养、反复动作等意思。", "confidence": 55}
{"id": "21-3822-2-13", "zh": "多种、超越、没有、强烈、统领、越过，", "confidence": 50}
{"id": "21-3823-2-10", "zh": "分离、争吵、显现、言说和轻蔑，", "confidence": 50}
{"id": "21-3825-2-10", "zh": "遥远、不面向、迷惑、不安定，", "confidence": 50}
{"id": "21-3826-2-9", "zh": "主要、善巧、疲倦、亲手等意思上，可以见到 vi。", "confidence": 50}
{"id": "21-3828-2-22", "zh": "分离、了知、下方、确定（复注读作 bhāga + anicchaya，即“不确定”）、清净，", "confidence": 45}
{"id": "21-3829-2-8", "zh": "轻微、轻视、处所、遍布、损失，", "confidence": 50}
{"id": "21-3830-2-8", "zh": "言语动作、偷盗、智、获得等意思上，用 ava。", "confidence": 50}
{"id": "21-3832-2-9", "zh": "之后、强烈、相似、不间断、随转，", "confidence": 55}
{"id": "21-3833-2-12", "zh": "低劣、第三格（具格）的意思、下方、部分、随行、利益，", "confidence": 40}
{"id": "21-3834-2-11", "zh": "处所、标志、分配、处于某种状态、部分等意思上，用 anu。", "confidence": 45}
{"id": "21-3836-2-9", "zh": "周遍、限定、供养、拥抱、回避，", "confidence": 55}
{"id": "21-3837-2-9", "zh": "说过失、穿着、轻慢、依托、饮食，", "confidence": 50}
{"id": "21-3838-2-9", "zh": "忧愁、遍布、真实、标志等意思上，可以用 pari。", "confidence": 45}
{"id": "21-3840-2-8", "zh": "面向、殊胜、向上、适合于业、增长，", "confidence": 45}
{"id": "21-3841-2-13", "zh": "以及供养、超过、家族、不实、标志等意思上，也用 abhi。", "confidence": 35}
{"id": "21-3843-2-15", "zh": "adhi 用于超过、统领、诵读、依处、到达，", "confidence": 50}
{"id": "21-3844-2-10", "zh": "也用于确定、在上、存在和区别。", "confidence": 45}
{"id": "21-3846-2-7", "zh": "回报、禁止、相反、拿取、返回，", "confidence": 50}
{"id": "21-3847-2-7", "zh": "相似、替代、面向和行去，", "confidence": 55}
{"id": "21-3849-2-8", "zh": "觉醒、对向而去，以及重复动作，", "confidence": 45}
{"id": "21-3850-2-8", "zh": "推重、缘于、标志等意思上，用 **patī**；", "confidence": 55}
{"id": "21-3851-2-10", "zh": "su 用于美好、快乐、正确、强烈、妥善、成就。", "confidence": 65}
