{"id": "21-791-2-9", "zh": "妓女叫 gaṇikā、vesiyā、vaṇṇadāsī、nagarasobhinī，", "confidence": 75}
{"id": "21-792-2-9", "zh": "还有 rūpūpajīvinī、vesī；不守贞节的女人叫 kulaṭā 和 bandhakī。", "confidence": 75}
{"id": "21-794-2-9", "zh": "美貌出众的女子叫 varārohā、uttamā、mattakāsinī、varavaṇṇinī；", "confidence": 70}
{"id": "21-795-2-8", "zh": "忠于丈夫的贞妇叫 patibbatā，也叫 satī；良家妇女叫 kulitthī、kulapālikā。", "confidence": 75}
{"id": "21-797-2-8", "zh": "寡妇叫 vidhavā、patisuññā；自己选择丈夫的女子叫 patimbarā、sayambarā；", "confidence": 75}
{"id": "21-798-2-9", "zh": "已经生育的妇女叫 vijātā、pasūtā，还有 jātāpaccā、pasūtikā。", "confidence": 75}
{"id": "21-800-2-9", "zh": "女信使叫 dūtī、sañcārikā；女仆叫 dāsī、ceṭī、kuṭadhārikā；", "confidence": 75}
{"id": "21-801-2-10", "zh": "vāruṇī 与 khaṇikā 是同义词；刹帝利种姓的女子叫 khattiyānī、khattiyā。", "confidence": 50}
{"id": "21-803-2-9", "zh": "妻子叫 dāra、jāyā、kalatta、gharaṇī、bhariyā、piyā，", "confidence": 80}
{"id": "21-804-2-8", "zh": "还有 pajāpatī、dutiyā，以及 pādaparicārikā。", "confidence": 80}
{"id": "21-806-2-13", "zh": "女伴叫 sakhī、ālī、vayassā；与人私通的女子叫 jārī，也叫 aticārinī；", "confidence": 75}
{"id": "21-807-2-12", "zh": "月经叫 utu（阳性）、rajo、puppha；处在经期的女人叫 utunī、rajassalā，", "confidence": 70}
{"id": "21-809-2-8", "zh": "也叫 pupphavatī；孕妇叫 garugabbhā、pannasattā、gabbhinī；", "confidence": 75}
{"id": "21-810-2-7", "zh": "胞衣叫 gabbhāsaya，也叫 jalābu；kalala 一词阳性、中性两用。", "confidence": 50}
{"id": "21-812-2-10", "zh": "丈夫叫 dhava、sāmika、bhattā、kanta、pati、vara、piya；", "confidence": 80}
{"id": "21-813-2-6", "zh": "情夫叫 upapati、jāra。", "confidence": 75}
{"id": "21-814-2-7", "zh": "儿子叫 apacca、putta、atraja、suta、", "confidence": 75}
{"id": "21-816-2-10", "zh": "tanuja、tanaya、sūnu；putta 等词用作阴性时指女儿；", "confidence": 65}
{"id": "21-817-2-5", "zh": "女儿也叫 duhitā、dhītā（阴性）。", "confidence": 70}
{"id": "21-818-2-7", "zh": "亲生的儿子叫 oraso。", "confidence": 70}
{"id": "21-820-2-21", "zh": "夫妻叫 jāyāpatī、janipatī、jayampatī、dampatī［dampatī 一词是阳性复数，以 i 结尾；复注本作 tudampati］；", "confidence": 65}
{"id": "21-821-2-9", "zh": "阉人叫 vassavara，也叫 paṇḍaka，还有 napuṃsaka。", "confidence": 75}
{"id": "21-823-2-9", "zh": "亲属叫 bandhava、bandhu、sajana、sagotta、ñāti、ñātaka、", "confidence": 80}
{"id": "21-824-2-5", "zh": "sālohita、sapiṇḍa；", "confidence": 80}
{"id": "21-825-2-6", "zh": "父亲叫 tāta、janaka、pitā。", "confidence": 85}
{"id": "21-827-2-11", "zh": "母亲叫 ammā、ambā、jananī、mātā、janetti、janikā；", "confidence": 80}
{"id": "21-828-2-7", "zh": "乳母叫 upamātā，也叫 dhātī（阴性）；", "confidence": 75}
{"id": "21-829-2-5", "zh": "妻子的兄弟叫 sāla。", "confidence": 80}
{"id": "21-831-2-9", "zh": "丈夫的姐妹叫 nanandā；外祖母叫 mātāmahī，也叫 ayyikā；", "confidence": 75}
{"id": "21-832-2-9", "zh": "舅舅叫 mātula，就是母亲的兄弟；舅舅的妻子叫 mātulānī。", "confidence": 75}
{"id": "21-834-2-8", "zh": "夫妻双方的母亲叫 sassu；他们的父亲", "confidence": 70}
{"id": "21-835-2-9", "zh": "叫 sasura；姐妹的儿子叫 bhāgineyya。", "confidence": 75}
{"id": "21-837-2-10", "zh": "孙子叫 nattā，也叫 paputta；丈夫的兄弟叫 devara；", "confidence": 75}
{"id": "21-838-2-5", "zh": "女儿的丈夫叫 jāmātā，", "confidence": 80}
{"id": "21-839-2-5", "zh": "祖父叫 ayyaka，也叫 pitāmaha。", "confidence": 80}
{"id": "21-841-2-8", "zh": "姨母叫 mātucchā，就是母亲的姐妹；姑母叫 pitucchā，就是父亲的姐妹；", "confidence": 80}
{"id": "21-842-2-4", "zh": "曾祖父叫 papitāmaha、payyaka；", "confidence": 80}
{"id": "21-843-2-6", "zh": "儿媳叫 suṇhā、suṇisā、husā。", "confidence": 80}
{"id": "21-845-2-9", "zh": "同胞兄弟叫 sodariya、sagabbha、sodara，也叫 sahaja；", "confidence": 75}
{"id": "21-846-2-9", "zh": "父亲和母亲合称 pitaro；儿子和女儿合称 puttā。", "confidence": 75}
{"id": "21-848-2-7", "zh": "公公和婆婆合称 sasurā；兄弟和姐妹合称 bhātaro；", "confidence": 75}
{"id": "21-849-2-9", "zh": "童年叫 bālatta、bālatā、bālya；青春叫 yobbañña，也叫 yobbana。", "confidence": 80}
{"id": "21-851-2-11", "zh": "变白的头发等叫 palita；衰老叫 jaratā、jarā；", "confidence": 70}
{"id": "21-852-2-9", "zh": "幼儿叫 puthuka、pillaka、chāpa、kumāra、bāla、potaka。", "confidence": 70}
{"id": "21-854-2-11", "zh": "仰卧的婴儿叫 uttānasaya、uttānaseyyaka，吃奶的婴儿叫 thanapa；", "confidence": 70}
{"id": "21-856-2-11", "zh": "年轻人叫 taruṇa、vayaṭṭha、dahara、yuvā、susu、", "confidence": 75}
{"id": "21-857-2-6", "zh": "māṇava、dāraka；娇生惯养的人叫 sukumāra、sukhedhita。", "confidence": 70}
{"id": "21-859-2-11", "zh": "老人叫 mahallaka、vuddha、thera、jiṇṇa、jiṇṇaka；", "confidence": 80}
{"id": "21-860-2-9", "zh": "兄长叫 aggaja、pubbaja、jeṭṭha；弟弟叫 kaniya、kaniṭṭha、anuja。", "confidence": 75}
{"id": "21-862-2-5", "zh": "皮肤起皱的人叫 valittaca，也叫 valina；", "confidence": 75}
{"id": "21-862-6-9", "zh": "uttānasaya 等词阳性、阴性、中性三性通用。", "confidence": 70}
{"id": "21-864-2-11", "zh": "头叫 sīsa、uttamaṅga、sira、muddhā、matthaka；", "confidence": 85}
{"id": "21-865-2-9", "zh": "头发叫 kesa、kuntala、vāla、uttamaṅgaruha、muddhaja。", "confidence": 85}
