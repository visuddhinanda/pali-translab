{"id": "21-1184-2-9", "zh": "伞叫作 ātapatta，也叫 chatta；国王的金座，", "confidence": 75}
{"id": "21-1185-2-9", "zh": "称为狮子座（sīhāsana）；拂尘叫作 vāḷabījanī（阴性），也叫 cāmara。", "confidence": 70}
{"id": "21-1187-2-9", "zh": "宝剑、伞盖、头冠、鞋履、拂尘，", "confidence": 80}
{"id": "21-1188-2-8", "zh": "这五样是国王的王权标志（kakudhabhaṇḍa）。", "confidence": 80}
{"id": "21-1190-2-7", "zh": "吉祥瓶（bhaddakumbha）也叫满瓶（puṇṇakumbha）；注水壶叫作 bhiṅkāra，也叫 jaladāyaka；", "confidence": 70}
{"id": "21-1191-2-14", "zh": "由象兵、马兵、车兵、步兵组成的军队，叫作四支军（caturaṅginī senā）。", "confidence": 80}
{"id": "21-1193-2-9", "zh": "象叫作 kuñjara、vāraṇa、hatthī、mātaṅga、dvirada、gaja、", "confidence": 85}
{"id": "21-1194-2-6", "zh": "nāga、dvipa、ibha、dantī；", "confidence": 85}
{"id": "21-1195-2-5", "zh": "象群之首叫作 yūthajeṭṭha，也叫 yūthapa。", "confidence": 80}
{"id": "21-1197-2-11", "zh": "黑象（kāḷāvaka）、恒河象（gaṅgeyya）、白象（paṇḍara）、铜色象（tamba）、褐黄象（piṅgala）、香象（gandha）、", "confidence": 75}
{"id": "21-1198-2-6", "zh": "吉祥象（maṅgala）、金色象（hema）、布萨象（uposatha）、", "confidence": 75}
{"id": "21-1199-2-5", "zh": "六牙象（chaddanta），这些是象的十种族系。", "confidence": 80}
{"id": "21-1201-2-9", "zh": "幼象叫作 kalabha，也叫 bhiṅka；发情的象叫作 pabhinna、matta、gajjita；", "confidence": 65}
{"id": "21-1202-2-9", "zh": "象群叫作 hatthighaṭā、gajatā；母象叫作 hatthinī、kareṇukā。", "confidence": 75}
{"id": "21-1204-2-8", "zh": "象头顶上的两团隆起叫作 kumbha；耳根叫作 cūlikā；", "confidence": 70}
{"id": "21-1205-2-8", "zh": "象肩部（骑坐处）叫作 āsana；尾根叫作 mecaka。", "confidence": 70}
{"id": "21-1207-2-10", "zh": "拴象的柱子叫作 ālāna、āḷhaka、thambha；脚镣叫作 nigaḷa、anduka（非阴性），", "confidence": 65}
{"id": "21-1208-2-5", "zh": "也叫 saṅkhala（三性通用）；象的颞颥叫作 gaṇḍa，", "confidence": 60}
{"id": "21-1209-2-7", "zh": "也叫 kaṭa；颞颥流出的发情液叫作 dāna，也叫 mada。", "confidence": 65}
{"id": "21-1211-2-7", "zh": "象鼻叫作 soṇḍa（阳、阴二性），也叫 hattha；", "confidence": 70}
{"id": "21-1212-2-5", "zh": "鼻尖叫作 pokkhara；", "confidence": 70}
{"id": "21-1213-2-9", "zh": "束在象身中部的带子叫作 kacchā；披毯等象的装具叫作 kappana。", "confidence": 65}
{"id": "21-1215-2-9", "zh": "供国王乘坐的象叫作 opavayha、rājavayha；配好装具的象叫作 sajjita、kappita；", "confidence": 70}
{"id": "21-1216-2-8", "zh": "刺象脚用的刺棒叫作 tomara（非阴性）。", "confidence": 65}
{"id": "21-1218-2-9", "zh": "刺耳根用的叫作 tutta，刺头顶用的叫作 aṅkusa（象钩）；", "confidence": 70}
{"id": "21-1219-2-4", "zh": "骑象的人叫作 hatthāroha、hatthimeṇḍa、", "confidence": 70}
{"id": "21-1220-2-4", "zh": "hatthipa、hatthigopaka。", "confidence": 70}
{"id": "21-1222-2-8", "zh": "调教象、马等的教练叫作 gāmaṇīya；", "confidence": 70}
{"id": "21-1223-2-5", "zh": "马叫作 haya、turaṅga、turaga、", "confidence": 85}
{"id": "21-1224-2-6", "zh": "vāha、assa、sindhava。", "confidence": 85}
{"id": "21-1226-2-5", "zh": "马的杂种（骡）叫作 assatara；", "confidence": 70}
{"id": "21-1227-2-5", "zh": "良种马叫作 ājānīya，也叫 kulīnaka；", "confidence": 75}
{"id": "21-1228-2-5", "zh": "乘坐舒适、经过调教的马叫作 sukhavāhī、vinīta；", "confidence": 65}
{"id": "21-1229-2-4", "zh": "小马叫作 kisora，也叫 hayapotaka。", "confidence": 80}
{"id": "21-1231-2-10", "zh": "劣马叫作 ghoṭaka、khaḷuṅka；快马叫作 javana、javādhika；", "confidence": 70}
{"id": "21-1232-2-9", "zh": "马嚼子叫作 mukhādhāna 或 khalīna；鞭马用的鞭子叫作 kasā。", "confidence": 75}
{"id": "21-1234-2-11", "zh": "穿鼻的缰绳叫作 kusā；母马叫作 vaḷavā；马蹄叫作 khura、sapha；", "confidence": 70}
{"id": "21-1235-2-9", "zh": "尾巴叫作 puccha（非阴性）、naṅguṭṭha、vālahattha、vāladhi。", "confidence": 75}
{"id": "21-1237-2-12", "zh": "车叫作 sandana、ratha；不用于作战的车叫作 phussaratha；", "confidence": 65}
{"id": "21-1238-2-5", "zh": "蒙着兽皮的车，蒙虎皮的叫作 veyaggha，", "confidence": 60}
{"id": "21-1239-2-5", "zh": "蒙豹皮的叫作 depa。", "confidence": 60}
{"id": "21-1241-2-19", "zh": "轿子叫作 sivikā、yāpyayāna；货车叫作 sakaṭa（非阴性），也叫 ana；", "confidence": 65}
{"id": "21-1242-2-9", "zh": "车轮称为 cakka、rathaṅga；车轮的外缘叫作 nemi（阴性）。", "confidence": 70}
{"id": "21-1244-2-9", "zh": "车轮的中心叫作 piṇḍikā、nābhi；车辕叫作 kubbara、yugandhara；", "confidence": 65}
{"id": "21-1245-2-10", "zh": "车轴末端的销子叫作 āṇī（阴性）；车的护栏叫作 varūtha。", "confidence": 65}
{"id": "21-1247-2-9", "zh": "车的前端叫作 dhura；车的部件有车轴（akkha）、pakkhara 等；", "confidence": 60}
{"id": "21-1248-2-7", "zh": "以象等为脚力的一切乘具都叫作 yāna、vāhana、yogga。", "confidence": 70}
{"id": "21-1250-2-10", "zh": "驾车的人叫作 rathacārī、sūta、pājitā、sārathi；", "confidence": 75}
{"id": "21-1251-2-5", "zh": "乘车作战的人叫作 rathāroha、rathika、", "confidence": 70}
{"id": "21-1252-2-7", "zh": "rathī；战士叫作 yodha、bhaṭa。", "confidence": 75}
{"id": "21-1254-2-10", "zh": "步兵叫作 padāti、pattī（阳性）、padaga、padika；", "confidence": 75}
{"id": "21-1255-2-9", "zh": "铠甲叫作 sannāha、kaṅkaṭa、vamma、kavaca、uracchada，", "confidence": 75}
{"id": "21-1257-2-11", "zh": "也叫 jālikā；披上铠甲的人叫作 sannaddha、sajja、vammika；", "confidence": 65}
{"id": "21-1258-2-8", "zh": "穿戴好的叫作 āmukka、paṭimukka；走在前面的叫作 purecārī、purecara、", "confidence": 65}
{"id": "21-1260-2-8", "zh": "pubbaṅgama、puregāmī；走得慢的叫作 mandagāmī、manthara；", "confidence": 75}
{"id": "21-1261-2-9", "zh": "迅速的叫作 javana、turita、vegī；应被战胜的叫作 jetabba，也叫 jeyya。", "confidence": 70}
