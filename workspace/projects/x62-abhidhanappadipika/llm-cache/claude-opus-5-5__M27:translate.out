{"id": "21-2048-2-8", "zh": "piyaka、camūru、kadalī、miga 等，是出皮革的鹿类（cammayoni）；", "confidence": 65}
{"id": "21-2049-2-9", "zh": "miga 与 pasu，则泛指狮子等一切四足兽。", "confidence": 75}
{"id": "21-2051-2-10", "zh": "lūtā、lūtikā、uṇṇanābhi、makkaṭaka，都指蜘蛛；", "confidence": 85}
{"id": "21-2052-2-10", "zh": "vicchika 又称为 āḷi，指蝎子；sarabū 指壁虎（gharagoḷikā）。", "confidence": 80}
{"id": "21-2054-2-9", "zh": "godhā、kuṇḍa 指巨蜥；另外，kaṇṇajalūkā、satapadī 指蜈蚣；", "confidence": 70}
{"id": "21-2055-2-9", "zh": "kalandaka、kāḷaka 指松鼠；nakula、maṅgusa 指獴。", "confidence": 75}
{"id": "21-2057-2-10", "zh": "kakaṇṭaka、saraṭa 指蜥蜴；kīṭa、puḷava、kimi 指虫；", "confidence": 75}
{"id": "21-2058-2-5", "zh": "pāṇaka 也指虫；另外，uccāliṅga", "confidence": 65}
{"id": "21-2059-2-4", "zh": "指多毛的虫（lomasapāṇaka），即毛虫。", "confidence": 65}
{"id": "21-2061-2-10", "zh": "vihaṅga、vihaga、pakkhī、vihaṅgama、khaga、aṇḍaja，", "confidence": 85}
{"id": "21-2062-2-10", "zh": "sakuṇa、sakunta、vi、pataṅga、sakuṇī、dvija，", "confidence": 85}
{"id": "21-2064-2-9", "zh": "以及 vakkaṅga、pattayāna、patanta、nīḷaja，都指鸟；", "confidence": 80}
{"id": "21-2065-2-9", "zh": "鸟的种类有 vaṭṭakā（鹌鹑）、jīvañjīva（命命鸟）、cakora（石鸡）、tittira（鹧鸪）。", "confidence": 65}
{"id": "21-2067-2-8", "zh": "sāḷikā（八哥）、karavīka（迦陵频伽鸟）、ravihaṃsa、kukutthaka，", "confidence": 55}
{"id": "21-2068-2-16", "zh": "以及 kāraṇḍava、pilava（复注本作 bilava）、pokkharasātaka 等。", "confidence": 55}
{"id": "21-2070-2-10", "zh": "patatta、pekhuṇa、patta、pakkha、piñcha、chada、garu，都指羽毛和翅膀；", "confidence": 75}
{"id": "21-2071-2-10", "zh": "aṇḍa 指鸟卵（pakkhibīja）；另外，nīḷa（非阴性）、kulāvaka 指鸟巢。", "confidence": 75}
{"id": "21-2073-2-7", "zh": "金翅鸟的母亲叫作 vinatā；mithuna 指一雌一雄的一对；", "confidence": 75}
{"id": "21-2074-2-10", "zh": "yuga、yugala、dvanda、yamaka、yamala、yama，都指一对、一双。", "confidence": 80}
{"id": "21-2076-2-9", "zh": "samūha、gaṇa、saṅghāta、samudāya、sañcaya，", "confidence": 85}
{"id": "21-2077-2-9", "zh": "sandoha、nivaha、ogha、visara、nikara、caya，", "confidence": 85}
{"id": "21-2079-2-9", "zh": "kāya、khandha、samudaya、ghaṭā、samiti、saṃhati，", "confidence": 85}
{"id": "21-2080-2-9", "zh": "rāsi、puñja、samavāya、pūga、jāta、kadambaka，", "confidence": 85}
{"id": "21-2082-2-11", "zh": "以及 byūha、vitāna、gumba、kalāpa、jāla、maṇḍala，都指群聚、集合；", "confidence": 80}
{"id": "21-2083-2-5", "zh": "同类事物的群叫作 vagga，", "confidence": 75}
{"id": "21-2084-2-6", "zh": "众生的群则叫作 saṅgha、sattha。", "confidence": 70}
{"id": "21-2086-2-9", "zh": "同一族类的群叫作 kula；奉行同一法的人的群叫作 nikāya；", "confidence": 75}
{"id": "21-2087-2-7", "zh": "yūtha（非阴性）用来称同类畜生的群。", "confidence": 75}
{"id": "21-2089-2-8", "zh": "supaṇṇa、venateyya、garuḷa、vihagādhipa，都指金翅鸟；", "confidence": 85}
{"id": "21-2090-2-8", "zh": "parapuṭṭha、parabhata、kuṇāla、kokila、pika，都指杜鹃鸟。", "confidence": 80}
{"id": "21-2092-2-8", "zh": "mora、mayūra、varahī、nīlagīva、sikhaṇḍī，", "confidence": 85}
{"id": "21-2093-2-12", "zh": "以及 kalāpī、sikhī、kekī，都指孔雀；cūḷā 和 sikhā 指冠羽、顶髻。", "confidence": 75}
{"id": "21-2095-2-8", "zh": "sikhaṇḍa、varaha、kalāpa、piñcha，都指孔雀的尾羽；", "confidence": 75}
{"id": "21-2096-2-9", "zh": "candaka、mecaka 指尾羽上的眼斑；另外，chappada、madhubbata，", "confidence": 65}
{"id": "21-2098-2-8", "zh": "madhulīha、madhukara、madhupa、bhamara、ali，都指蜜蜂；", "confidence": 80}
{"id": "21-2099-2-9", "zh": "pārāvata、kapota、kakuṭa、pārevata，都指鸽子。", "confidence": 80}
{"id": "21-2101-2-9", "zh": "gijjha、gaddha 指鹫；另外，kulala、sena、byagghīnasa 指鹰；", "confidence": 70}
{"id": "21-2102-2-9", "zh": "鹰的一种叫作 sakuṇagghī（阴性）；āṭa 指匙嘴鸟（dabbimukhadvija）。", "confidence": 60}
{"id": "21-2104-2-9", "zh": "uhuṅkāra、ulūka、kosiya、vāyasāri，都指猫头鹰；", "confidence": 80}
{"id": "21-2105-2-12", "zh": "kāka、ariṭṭha、dhaṅka、balipuṭṭha、vāyasa，都指乌鸦。", "confidence": 85}
{"id": "21-2107-2-5", "zh": "kākola 指林中的乌鸦；", "confidence": 75}
{"id": "21-2108-2-5", "zh": "另外，lāpa、laṭukikā 指鹌鹑一类的小鸟；", "confidence": 60}
{"id": "21-2109-2-7", "zh": "vāraṇa、hatthiliṅga、hatthisoṇḍavihaṅgama，指一种长着象鼻般喙的鸟。", "confidence": 55}
{"id": "21-2111-2-9", "zh": "ukkusa、kurara 指鹗；kukkuha 用来称 koḷaṭṭhi 鸟；", "confidence": 50}
{"id": "21-2112-2-11", "zh": "suva、kīra、suka 指鹦鹉；tambacūḷa、kukkuṭa 指公鸡。", "confidence": 80}
{"id": "21-2114-2-10", "zh": "vanakukkuṭa、nijjivha 指野鸡；另外，koñcā、kuntanī 指鹤；", "confidence": 65}
{"id": "21-2115-2-9", "zh": "cakkavāka、cakkavha 指赤麻鸭；sāraṅga、cātaka 指饮雨鸟。", "confidence": 60}
{"id": "21-2117-2-4", "zh": "tuliya 指飞狐（pakkhibiḷāla），", "confidence": 55}
{"id": "21-2118-2-5", "zh": "satapatta 指仙鹤（sārasa）；", "confidence": 60}
{"id": "21-2119-2-5", "zh": "baka 指白鹭（sukkakāka），", "confidence": 65}
{"id": "21-2120-2-4", "zh": "balākā 指鹭（visakaṇṭhikā）。", "confidence": 60}
{"id": "21-2122-2-9", "zh": "lohapiṭṭha 又叫 kaṅka，指苍鹭；khañjarīṭa、khañjana 指鹡鸰；", "confidence": 60}
{"id": "21-2123-2-10", "zh": "kalaviṅka、cāṭaka 指麻雀；dindibha、kikī 指田凫。", "confidence": 60}
