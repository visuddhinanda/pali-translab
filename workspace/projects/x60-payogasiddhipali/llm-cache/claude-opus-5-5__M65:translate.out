{"id":"19-1864-58-61","zh":"bhavissase、bhavissavhe。","confidence":85}
{"id":"19-1864-62-65","zh":"bhavissaṃ、bhavissāmhe。","confidence":85}
{"id":"19-1865-2-3","zh":"在被动语态中：","confidence":80}
