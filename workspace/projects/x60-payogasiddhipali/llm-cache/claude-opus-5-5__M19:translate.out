{"id": "19-595-2-7", "zh": "116. Ye passivaṇṇassa（在 ya 之前，名为 pa 的 i 类元音〔可以省略〕）", "confidence": 70}
{"id": "19-596-2-8", "zh": "名为 pa 的 i 类元音，在 ya 音之前可以省略。", "confidence": 80}
{"id": "19-596-9-26", "zh": "由于从“Paro kvaci”承接下来的 kvaci（有时）一词，在 ya 之前不发生 c 音化，也不发生与前音同化。", "confidence": 60}
{"id": "19-596-27-28", "zh": "得 matyo。", "confidence": 80}
{"id": "19-596-29-42", "zh": "在其他情况下，依“jantvā”等规则省略 yo，元音变长，得 matī、matiyo。", "confidence": 75}
{"id": "19-596-43-50", "zh": "呼格：bho mati、matī；复数 matyo、matī、matiyo。", "confidence": 75}
{"id": "19-596-51-56", "zh": "宾格：matiṃ；复数 matyo、matī、matiyo。", "confidence": 75}
{"id": "19-596-57-61", "zh": "具格：matiyā；复数 matīhi、matībhi。", "confidence": 75}
{"id": "19-596-62-66", "zh": "与格、属格：matyā、matiyā；复数 matīnaṃ。", "confidence": 70}
{"id": "19-596-67-76", "zh": "smiṃ 变为 yaṃ。处格：matyaṃ、matiyaṃ、matyā、matiyā；复数 matīsu。", "confidence": 70}
{"id": "19-596-77-78", "zh": "同样变化的还有：", "confidence": 80}
{"id": "19-597-2-11", "zh": "patti（获得）、yutti（合理）、vutti（解释）、kitti（名声）、mutti（解脱）、titti（满足）、khanti（忍耐）、kanti（光彩）；", "confidence": 70}
{"id": "19-598-2-11", "zh": "santi（寂静）、tanti（线、典籍）、siddhi（成就）、suddhi（清净）、iddhi（神通）、vuddhi（增长）、buddhi（智慧）、bodhi（菩提）。", "confidence": 70}
{"id": "19-599-2-11", "zh": "bhūmi（大地）、jāti（出生）、pīti（喜）、suti（听闻）、nandi（欢喜）、sandhi（连接）、soṇi（臀部）、koṭi（顶端）；", "confidence": 70}
{"id": "19-600-2-11", "zh": "diṭṭhi（见解）、vuṭṭhi（雨）、tuṭṭhi（满意）、yaṭṭhi（手杖）、pāḷi（行列、圣典）、āḷi（堤岸）、nāḷi（管子）、keḷi（游戏）。", "confidence": 65}
{"id": "19-601-2-10", "zh": "sati（念）、muti（觉知）、gati（去处）、cuti（死没）、dhiti（坚毅）、yuvati（少女）、vikati（变化）；", "confidence": 70}
{"id": "19-602-2-10", "zh": "rati（喜乐）、ruci（喜好）、rasmi（光线）、asani（雷电）、vasani（住处）、osadhi（药草）、aṅguli（手指）；", "confidence": 60}
{"id": "19-603-2-9", "zh": "dhūli（尘土）、dudrabhi（鼓）、doṇi（槽）、aṭavi（森林）、chavi（皮肤）等等。", "confidence": 55}
{"id": "19-604-2-6", "zh": "55. Ratyādīhi ṭo smino（在 ratti 等词之后，smiṃ 变为 o）", "confidence": 70}
{"id": "19-605-2-7", "zh": "在 ratti 等词之后，smiṃ 可以变为 o（ṭo）。", "confidence": 75}
{"id": "19-605-8-15", "zh": "处格：ratto、ratyaṃ、rattiyaṃ、ratyā、rattiyā；复数 rattīsu。", "confidence": 75}
{"id": "19-605-16-18", "zh": "其余变化与 mati 相同。", "confidence": 85}
{"id": "19-606-2-3", "zh": "以 i 结尾的词到此为止。", "confidence": 75}
{"id": "19-607-2-5", "zh": "dāsī（女仆）：省略 si。", "confidence": 75}
{"id": "19-607-6-13", "zh": "依“Ekavacana”等规则，元音变短。", "confidence": 65}
{"id": "19-607-14-26", "zh": "依“Ye passivaṇṇassa”规则省略 ī，得 dāsyo。", "confidence": 75}
{"id": "19-607-27-34", "zh": "依“Jantvā”等规则省略 yo。", "confidence": 75}
{"id": "19-607-35-37", "zh": "得 dāsī、dāsiyo。", "confidence": 80}
{"id": "19-607-38-46", "zh": "依“Ge vā”规则，元音变短。", "confidence": 75}
{"id": "19-607-47-54", "zh": "呼格：bho dāsi、dāsī；复数 dāsyo、dāsī、dāsiyo。", "confidence": 75}
{"id": "19-608-2-5", "zh": "73. Yaṃ pito（在名为 pa 的 ī 之后，aṃ 变为 yaṃ）", "confidence": 70}
{"id": "19-609-2-7", "zh": "在名为 pa 的 ī 之后，宾格单数词尾 aṃ 可以变为 yaṃ。", "confidence": 75}
{"id": "19-609-8-15", "zh": "宾格：dāsyaṃ、dāsiyaṃ、dāsiṃ；复数 dāsyo、dāsī、dāsiyo。", "confidence": 75}
{"id": "19-609-16-23", "zh": "依“Ghapatekā”等规则，变为 yā。", "confidence": 70}
{"id": "19-609-24-30", "zh": "具格：dāsyā、dāsiyā；复数 dāsīhi、dāsībhi。", "confidence": 75}
{"id": "19-609-31-35", "zh": "与格、属格：dāsyā、dāsiyā；复数 dāsīnaṃ。", "confidence": 70}
{"id": "19-609-36-42", "zh": "处格：dāsyaṃ、dāsiyaṃ、dāsyā、dāsiyā；复数 dāsīsu。", "confidence": 70}
{"id": "19-609-43-44", "zh": "同样变化的还有：", "confidence": 80}
{"id": "19-610-2-9", "zh": "mahī（大地）、vetaraṇī（吠多罗尼河）、vāpī（池塘）、pāṭalī（波吒厘树）、kadalī（芭蕉）、ghaṭī（水罐）；", "confidence": 70}
{"id": "19-611-2-9", "zh": "nārī（女人）、kumārī（少女）、taruṇī（年轻女子）、vāruṇī（酒）、brāhmaṇī（婆罗门女）、sakhī（女友）。", "confidence": 70}
{"id": "19-612-2-10", "zh": "gandhabbī（乾闼婆女）、kinnarī（紧那罗女）、nāgī（龙女）、devī（天女）、yakkhī（夜叉女）、ajī（母山羊）、migī（母鹿）；", "confidence": 75}
{"id": "19-613-2-10", "zh": "vānarī（母猴）、sūkarī（母猪）、sīhī（母狮）、haṃsī（雌天鹅）、kākī（雌乌鸦），以及 kukkuṭī（母鸡）。", "confidence": 75}
{"id": "19-614-2-3", "zh": "等等。", "confidence": 85}
{"id": "19-615-2-9", "zh": "这里，省略 ī 之后，形成与前音同化的 ñña：vetarañño、vetaraṇiyo。", "confidence": 60}
{"id": "19-615-10-17", "zh": "宾格：vetaraññaṃ、vetaraṇiyaṃ、vetaraṇiṃ；复数 vetarañño、vetaraṇiyo，等等。", "confidence": 65}
{"id": "19-615-18-19", "zh": "遇到 yo 时：", "confidence": 60}
