{"id": "16-1858-12-13", "zh": "javati（疾行）。", "confidence": 85}
{"id": "16-1858-14-15", "zh": "pavati（行进）。", "confidence": 80}
{"id": "16-1858-16-17", "zh": "plavati（漂行、渡过）。", "confidence": 80}
{"id": "16-1858-18-19", "zh": "gāti（行走）。", "confidence": 85}
{"id": "16-1858-20-21", "zh": "seti（行走）。", "confidence": 70}
{"id": "16-1858-22-25", "zh": "cavanaṃ（移去）、cuti（死没）。", "confidence": 80}
{"id": "16-1858-26-29", "zh": "javanaṃ（疾行）、javo（速度）。", "confidence": 80}
{"id": "16-1858-30-33", "zh": "pavanaṃ（行进）、plavanaṃ（漂渡）。", "confidence": 75}
{"id": "16-1858-34-35", "zh": "gānaṃ（行走）。", "confidence": 85}
