{"id": "4-487-2-6", "zh": "能随心所欲地化现，", "confidence": 75}
{"id": "4-488-2-5", "zh": "我礼敬那位通达一切所知的人。", "confidence": 80}
{"id": "4-490-2-5", "zh": "能在水上与空中行走，", "confidence": 75}
{"id": "4-491-2-4", "zh": "愿我能潜入地中；", "confidence": 75}
{"id": "4-492-2-5", "zh": "能随心所欲地化现，", "confidence": 75}
{"id": "4-493-2-4", "zh": "生生世世凭着业生的神通。", "confidence": 75}
{"id": "4-495-2-7", "zh": "在村落、在林野、在一切地方，", "confidence": 85}
{"id": "4-496-2-5", "zh": "天人与人们", "confidence": 80}
{"id": "4-497-2-3", "zh": "带来无尽的供养，", "confidence": 75}
{"id": "4-498-2-5", "zh": "这位大仙人一向如此；", "confidence": 65}
{"id": "4-499-2-4", "zh": "他在世间得到最上的供养，", "confidence": 60}
{"id": "4-500-2-5", "zh": "我礼敬那位牟尼中的至尊。", "confidence": 85}
{"id": "4-502-2-7", "zh": "在村落、在林野、在一切地方，", "confidence": 85}
{"id": "4-503-2-5", "zh": "愿天人与人们", "confidence": 80}
{"id": "4-504-2-5", "zh": "为我带来无尽的供养，", "confidence": 75}
{"id": "4-505-2-5", "zh": "生生世世一向如此。", "confidence": 80}
{"id": "4-507-2-4", "zh": "凭着这份功德的威力，", "confidence": 85}
{"id": "4-508-2-5", "zh": "愿我心中所想的都能实现；", "confidence": 85}
{"id": "4-509-2-6", "zh": "一切愿望与一切心念，", "confidence": 80}
{"id": "4-510-2-5", "zh": "生生世世都迅速成就。", "confidence": 80}
{"id": "4-512-2-5", "zh": "说“没有”是苦，", "confidence": 85}
{"id": "4-513-2-5", "zh": "说“给我”也同样是苦；", "confidence": 85}
{"id": "4-514-2-5", "zh": "所以“没有”与“给我”这两句话，", "confidence": 85}
{"id": "4-515-2-6", "zh": "愿我生生世世都不必说出口。", "confidence": 85}
{"id": "4-517-2-6", "zh": "一切受他人支配都是苦，", "confidence": 85}
{"id": "4-518-2-4", "zh": "一切自主都是乐；", "confidence": 85}
{"id": "4-519-2-4", "zh": "愿一切他者都归我支配，", "confidence": 45}
{"id": "4-520-2-4", "zh": "愿我在一切事上都得自在。", "confidence": 60}
{"id": "4-522-2-4", "zh": "身体不会被摧毁，", "confidence": 35}
{"id": "4-523-2-5", "zh": "能抵御一切兵器，", "confidence": 65}
{"id": "4-524-2-4", "zh": "具有六牙象王的力量，", "confidence": 75}
{"id": "4-525-2-5", "zh": "愿我生生世世都能如此。", "confidence": 75}
{"id": "4-527-2-4", "zh": "具足吉祥的相好，", "confidence": 80}
{"id": "4-528-2-4", "zh": "愿我有金色的肤色；", "confidence": 80}
{"id": "4-529-2-4", "zh": "有梵音，像迦陵频伽鸟那样", "confidence": 70}
{"id": "4-530-2-5", "zh": "生生世世以美妙的声音说话。", "confidence": 70}
{"id": "4-532-2-4", "zh": "具有广大的智慧，对一切技艺", "confidence": 75}
{"id": "4-533-2-5", "zh": "愿我都能精通；", "confidence": 80}
{"id": "4-534-2-4", "zh": "能够解答", "confidence": 80}
{"id": "4-535-2-4", "zh": "一切问题，随问随答。", "confidence": 65}
{"id": "4-537-2-6", "zh": "财富不被怨敌摧毁，", "confidence": 50}
{"id": "4-538-2-4", "zh": "拥有无尽、不会耗竭的财富；", "confidence": 65}
{"id": "4-539-2-4", "zh": "拥有无数不会离散的随众，", "confidence": 60}
{"id": "4-540-2-5", "zh": "生生世世如此，直到证得寂静的涅槃。", "confidence": 60}
{"id": "4-542-2-6", "zh": "愿我的财物不会毁失，也不会被强夺，", "confidence": 45}
{"id": "4-543-2-5", "zh": "即使有众多觊觎的人在旁；", "confidence": 35}
{"id": "4-544-2-4", "zh": "愿千千万万的五种怨敌", "confidence": 40}
{"id": "4-545-2-5", "zh": "都无法把我的财物作违我心愿的处置。", "confidence": 35}
{"id": "4-547-2-5", "zh": "云雨、风与宝物，", "confidence": 75}
{"id": "4-548-2-5", "zh": "谷物、衣服与饮食；", "confidence": 85}
{"id": "4-549-2-4", "zh": "一切想要的东西以及其他种种，", "confidence": 80}
{"id": "4-550-2-4", "zh": "愿我都能凭业生的神通化现出来。", "confidence": 80}
{"id": "4-552-2-5", "zh": "凭着这份功德，在我证得涅槃——", "confidence": 65}
{"id": "4-553-2-5", "zh": "那寂静的境界——之前；", "confidence": 60}
{"id": "4-554-2-4", "zh": "愿我在一切生中，", "confidence": 80}
{"id": "4-555-2-4", "zh": "常常具足四种成就；", "confidence": 75}
