{"id": "4-2-2-2", "zh": "经礼敬文", "confidence": 85}
{"id": "4-4-2-6", "zh": "法、义、教说、通达，", "confidence": 80}
{"id": "4-5-2-4", "zh": "这四种甚深而难以见到；", "confidence": 80}
{"id": "4-6-2-5", "zh": "为世间宣说这法的", "confidence": 80}
{"id": "4-7-2-4", "zh": "法王，我向他礼敬；", "confidence": 85}
{"id": "4-9-2-6", "zh": "佛陀与辟支佛，", "confidence": 90}
{"id": "4-10-2-4", "zh": "阿罗汉与转轮王——", "confidence": 88}
{"id": "4-11-2-4", "zh": "我礼敬那位最值得建塔供奉的人，", "confidence": 65}
{"id": "4-12-2-4", "zh": "他在这四种值得建塔的人之中居首；", "confidence": 65}
{"id": "4-14-2-5", "zh": "饿鬼的卧法、受用欲乐者的卧法，", "confidence": 75}
{"id": "4-15-2-4", "zh": "狮子的卧法、如来的卧法；", "confidence": 75}
{"id": "4-16-2-4", "zh": "在这四种卧法之中，", "confidence": 80}
{"id": "4-17-2-5", "zh": "以第四种卧法安卧的胜者，我向他礼敬；", "confidence": 78}
{"id": "4-19-2-5", "zh": "卵生与胎生，", "confidence": 90}
{"id": "4-20-2-4", "zh": "湿生与化生；", "confidence": 90}
{"id": "4-21-2-4", "zh": "能够辨明这四种生的", "confidence": 80}
{"id": "4-22-2-5", "zh": "具有智慧的胜者，我向他礼敬；", "confidence": 82}
{"id": "4-24-2-5", "zh": "多闻佛与随觉佛，", "confidence": 70}
{"id": "4-25-2-4", "zh": "辟支佛与胜者佛——", "confidence": 75}
{"id": "4-26-2-4", "zh": "四种佛中的第四种，", "confidence": 80}
{"id": "4-27-2-4", "zh": "世间的导师，我向他礼敬；", "confidence": 88}
{"id": "4-29-2-5", "zh": "罗睺在拥有大身体者中居首，", "confidence": 72}
{"id": "4-30-2-4", "zh": "曼达多在受用欲乐者中居首；", "confidence": 78}
{"id": "4-31-2-4", "zh": "魔罗在掌握权势者中居首，", "confidence": 75}
{"id": "4-32-2-5", "zh": "佛陀在包括天界在内的世间居首；", "confidence": 80}
{"id": "4-33-2-4", "zh": "在这四种被称为第一的人之中，", "confidence": 72}
{"id": "4-34-2-5", "zh": "达到最高第一的胜者，我向他礼敬。", "confidence": 75}
{"id": "4-36-2-6", "zh": "布施、爱语、利行、", "confidence": 85}
{"id": "4-37-2-4", "zh": "同事；", "confidence": 82}
{"id": "4-38-2-4", "zh": "以这四种摄事，", "confidence": 85}
{"id": "4-39-2-4", "zh": "在无数次的生命中", "confidence": 82}
{"id": "4-40-2-4", "zh": "摄受世间众生的", "confidence": 82}
{"id": "4-41-2-4", "zh": "世间的导师，我向他礼敬；", "confidence": 88}
{"id": "4-43-2-6", "zh": "贪、嗔、痴，", "confidence": 90}
{"id": "4-44-2-5", "zh": "这三种是内在的敌人；", "confidence": 85}
{"id": "4-45-2-5", "zh": "它们比一切仇敌都更难战胜，", "confidence": 80}
{"id": "4-46-2-5", "zh": "连它们也已战胜的智者，我向他礼敬；", "confidence": 72}
{"id": "4-48-2-5", "zh": "出身的伟大、福德的伟大，", "confidence": 80}
{"id": "4-49-2-3", "zh": "以及最殊胜的功德的伟大；", "confidence": 80}
{"id": "4-50-2-4", "zh": "具足这三种伟大的", "confidence": 82}
{"id": "4-51-2-4", "zh": "世间的导师，我向他礼敬；", "confidence": 88}
{"id": "4-53-2-6", "zh": "因的圆满、果的圆满，", "confidence": 82}
{"id": "4-54-2-3", "zh": "以及利益众生的圆满；", "confidence": 82}
{"id": "4-55-2-4", "zh": "具足这三种圆满的", "confidence": 85}
{"id": "4-56-2-4", "zh": "世间的导师，我向他礼敬。", "confidence": 88}
{"id": "4-58-2-3", "zh": "智慧、断除、威力，", "confidence": 78}
{"id": "4-59-2-3", "zh": "以及美好色身的圆满；", "confidence": 60}
{"id": "4-60-2-4", "zh": "以这四种果的圆满", "confidence": 78}
{"id": "4-61-2-6", "zh": "而具足的胜者，我向他礼敬。", "confidence": 80}
{"id": "4-63-2-6", "zh": "意乐与加行，", "confidence": 78}
{"id": "4-64-2-4", "zh": "这是利益众生的圆满；", "confidence": 80}
{"id": "4-65-2-5", "zh": "谁圆满具足了这两种，", "confidence": 82}
{"id": "4-66-2-7", "zh": "愿那位胜者好好护佑我。", "confidence": 82}
{"id": "4-68-2-4", "zh": "在大药和毗输安呾啰的那两世，", "confidence": 72}
{"id": "4-69-2-4", "zh": "以及最后一生；", "confidence": 80}
{"id": "4-70-2-5", "zh": "在这三世里，我礼敬那位", "confidence": 75}
{"id": "4-71-2-4", "zh": "在出生的刹那就开口说话的人。", "confidence": 78}
{"id": "4-73-2-6", "zh": "在尼弥、娑底那，", "confidence": 70}
{"id": "4-74-2-5", "zh": "以及曼达多和古提拉这几世；", "confidence": 70}
{"id": "4-75-2-4", "zh": "在这四世里以人身", "confidence": 78}
{"id": "4-76-2-5", "zh": "前往天界的那位，我向他礼敬。", "confidence": 80}
{"id": "4-78-2-4", "zh": "行、色的变异，", "confidence": 75}
{"id": "4-79-2-4", "zh": "相，以及脱离爱欲之林的", "confidence": 60}
{"id": "4-80-2-5", "zh": "涅槃，还有施设——", "confidence": 72}
{"id": "4-81-2-5", "zh": "通达这五种所知之边际的人，我向他礼敬。", "confidence": 70}
