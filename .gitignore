/tmp/
*.egg-info
__pycache__/

# Project-local config and caches
/config.toml
.cache/
**/.cache/

# 本地产物（译文正本在 wikipali）：只提交新机器继续工作所需的，
# cache / log / export / epub / zip / llm-cache 都能重建，不提交
/workspace/*
!/workspace/projects/
/workspace/projects/index.html
/workspace/projects/*/*
!/workspace/projects/*/project.json
!/workspace/projects/*/plan.csv
!/workspace/projects/*/tasks.csv
!/workspace/projects/*/audit.log
# 进度台账的历史版本（v1 / redo 等）也要带走，新机器靠它们接着跑
!/workspace/projects/*/project.*.json
!/workspace/projects/*/plan.*.csv
!/workspace/projects/*/tasks.*.csv
!/workspace/projects/*/audit.*.log
!/workspace/projects/*/reports/
# 藏外 x22–x62 的模型产物：只缓存翻译、尚未上传，换机器续传要用（上传完可移出 git）
!/workspace/projects/x2[2-9]-*/llm-cache/
!/workspace/projects/x[3-6][0-9]-*/llm-cache/
# 只上传开关（run_solo_pool / finish_and_mail 读它）
!/workspace/UPLOAD_ONLY
# 重新规划要用的对齐表 / 对照表（含手工 overrides）与故事型计划的专名表
!/workspace/projects/*/align.json
!/workspace/projects/*/align/
!/workspace/projects/*/names.json
!/workspace/projects/*/project.scan.json
!/workspace/terms/
/workspace/terms/*
!/workspace/terms/*.md

# Personal CLAUDE config
/CLAUDE.local.md

# Local memory / session data
/.claude/projects/
/.claude/RESUME.md
/.claude/scheduled_tasks.lock
